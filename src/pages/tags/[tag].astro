---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ThreadCard from "@/components/ThreadCard.astro";
import { allTags, getThreadsByTag } from "@/data/forum";

export const prerender = true;

export function getStaticPaths() {
  return allTags.map((tag) => ({
    params: { tag },
  }));
}

const tag = Astro.params.tag ?? "";
const taggedThreads = getThreadsByTag(tag);
---

<BaseLayout
  title={`#${tag}`}
  description={`Growth Circuit threads tagged ${tag}.`}
  path={`/tags/${tag}`}
  noindex={taggedThreads.length === 0}
>
  <section class="shell page-title">
    <p class="eyebrow">Topic</p>
    <h1>#{tag}</h1>
    <p>{taggedThreads.length} public threads in this lane.</p>
  </section>
  <section class="shell page-grid">
    <div class="thread-list">
      {taggedThreads.map((thread) => <ThreadCard thread={thread} />)}
    </div>
    <aside class="side-panel">
      <h2>Topic strategy</h2>
      <p>Topic pages should stay indexable only once they have enough useful threads to stand on their own.</p>
    </aside>
  </section>
</BaseLayout>
