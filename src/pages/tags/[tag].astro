---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementHold from "@/components/AnnouncementHold.astro";
import { allTags } from "@/data/forum";

export const prerender = true;

export function getStaticPaths() {
  return allTags.map((tag) => ({
    params: { tag },
  }));
}

const tag = Astro.params.tag ?? "";
---

<BaseLayout
  title={`#${tag}`}
  description="Growth Circuit topic pages are paused while the announcement focuses on the NYC supper club."
  path={`/tags/${tag}`}
  noindex
>
  <AnnouncementHold
    eyebrow="Coming later"
    title={`#${tag} is paused for launch.`}
    description="Topic pages are still scaffolded, but we are keeping the public announcement focused on the NYC supper club."
  />
</BaseLayout>
