---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ApplicationForm from "@/components/ApplicationForm";
---

<BaseLayout
  title="Growth Circuit"
  description="A NYC supper club for marketing engineers who bring their own builds."
  hideHeader
  bodyClass="home-ink-page"
>
  <div class="ink-hero">
    <div class="ink-hero__grid" aria-hidden="true"></div>
    <div class="ink-hero__glow" aria-hidden="true"></div>

    <header class="ink-header">
      <div class="shell ink-nav">
        <a class="brand" href="/" aria-label="Growth Circuit home">
          <span class="brand-mark brand-mark--light">GC</span>
          <span class="brand-word">Growth Circuit</span>
        </a>
        <nav class="ink-links" aria-label="Primary navigation">
          <a href="/nyc">Supper club</a>
          <a href="#global">Global community</a>
        </nav>
        <div class="header-actions">
          <a class="button matcha" href="#apply">Apply for NYC</a>
        </div>
      </div>
    </header>

    <section class="shell ink-section">
      <div class="ink-intro">
        <p class="eyebrow eyebrow--live">NYC supper club</p>
        <h1 class="ink-title">
          A dinner series for people who <span>bring the build</span>
        </h1>
        <p class="ink-lead">
          Growth Circuit starts as a small NYC supper club for marketing engineers, growth operators,
          and technical marketers who want to compare real work in the room.
        </p>
        <div class="hero-actions">
          <a class="button matcha" href="#apply">Apply for NYC</a>
          <a class="button button--ghost-light" href="#global">Not in NYC?</a>
        </div>
      </div>

      <div class="ink-ledger" aria-label="Supper club overview">
        <div class="ink-stat"><strong>12</strong><span>seats per dinner</span></div>
        <div class="ink-stat"><strong>NYC</strong><span>first chapter</span></div>
        <div class="ink-stat"><strong>Monthly</strong><span>build demos</span></div>
        <div class="ink-stat ink-stat--accent"><strong>Global</strong><span>community next</span></div>
      </div>

      <a class="ink-ticker" href="#global">
        <span class="ink-ticker__tag">Not in NYC?</span>
        <span class="ink-ticker__rule" aria-hidden="true"></span>
        <span class="ink-ticker__title">We are starting around one table, then opening a global community for everyone else.</span>
        <span class="ink-ticker__cta">Read note -></span>
      </a>
    </section>
  </div>

  <section class="shell page-grid home-forum-grid announcement-grid">
    <div class="side-panel announcement-panel">
      <p class="eyebrow">How it works</p>
      <h2>One theme. A little homework. Dinner around the work.</h2>
      <p>
        Each supper club starts with a practical growth problem. Members bring what they built, what
        broke, and what they would do differently. No panels, no pitches, no vague networking fog.
      </p>
      <div class="ritual-list" aria-label="Supper club structure">
        <div><strong>Before dinner</strong><span>A theme goes out</span></div>
        <div><strong>At the table</strong><span>Members demo and compare notes</span></div>
        <div><strong>Afterward</strong><span>The useful lessons become the seed for the wider community</span></div>
      </div>
    </div>

    <aside class="side-stack">
      <ApplicationForm client:load />
      <section class="side-panel" id="global">
        <p class="eyebrow">Global next</p>
        <h2>Not in New York?</h2>
        <p>
          The public community is still part of the plan. We are keeping the launch focused on the
          supper club first, then we will open up a global space for people who want the prompts,
          sharebacks, and build notes without being in NYC.
        </p>
      </section>
    </aside>
  </section>
</BaseLayout>
