---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementFaq from "@/components/AnnouncementFaq.astro";
---

<BaseLayout
  title="Growth Circuit"
  description="A close-knit community for Marketing Engineers based in New York City."
  hideHeader
  bodyClass="sky-page home-sky-page"
>
  <div class="ink-hero">
    <div class="ink-hero__grid" aria-hidden="true"></div>
    <div class="ink-hero__glow" aria-hidden="true"></div>

    <header class="ink-header">
      <div class="shell ink-nav">
        <a class="brand" href="/" aria-label="Growth Circuit home">
          <span class="brand-mark brand-mark--light">GC</span>
          <span class="brand-word">Growth Circuit</span>
        </a>
        <div class="header-actions">
          <a class="button matcha" href="/apply">Apply now</a>
        </div>
      </div>
    </header>

    <section class="shell ink-section">
      <div class="sky-orbit sky-orbit--one" aria-hidden="true"></div>
      <div class="sky-orbit sky-orbit--two" aria-hidden="true"></div>
      <div class="ink-intro">
        <p class="eyebrow eyebrow--live">New York, September 2026</p>
        <h1 class="ink-title">
          Build with people who <span>get what you do.</span>
        </h1>
        <p class="ink-lead">
          Growth Circuit is a close-knit community for marketing engineers who want to share their work, sharpen the
          craft, and make cool sh*t together.
        </p>
        <div class="hero-actions">
          <a class="button matcha" href="/apply">Apply for New York</a>
          <a class="text-link" href="/apply?path=global">Join the global waitlist <span>↗</span></a>
        </div>
      </div>

      <div class="ink-ledger" aria-label="Community overview">
        <div class="ink-stat"><strong>8</strong><span>spaces</span></div>
        <div class="ink-stat"><strong>NYC</strong><span>in person</span></div>
        <div class="ink-stat ink-stat--accent"><strong>Sep</strong><span>starting 2026</span></div>
      </div>
    </section>
  </div>

  <section class="shell flow-section">
    <div class="flow-copy">
      <p class="eyebrow">How it works</p>
      <h2>
        <span>One theme per month.</span>
        <span>Bring your own build.</span>
        <span>Iterate together.</span>
      </h2>
    </div>
    <div class="format-details" aria-label="Growth Circuit format">
      <div>
        <strong>Plan</strong>
        <span>Every month we'll vote on the theme, whether it’s a problem, tool, or question for the group to explore.</span>
      </div>
      <div>
        <strong>Build</strong>
        <span>Bring your ideas, MVPs, and half-baked projects.</span>
      </div>
      <div>
        <strong>Meet</strong>
        <span>Get together for demos and good food.</span>
      </div>
    </div>
  </section>

  <section class="show-us" aria-labelledby="show-us-title">
    <div class="shell show-us__inner">
      <p class="eyebrow">Applications open</p>
      <h2 id="show-us-title">Show us what you’ve built.</h2>
      <p class="show-us__lead">
        Show off the build you’re most proud of. Upload a video demo, a live link, or a GitHub repo.
      </p>
      <a class="button matcha" href="/apply">Start your application</a>
    </div>
  </section>

  <section class="shell principles-section">
    <div class="principles-copy">
      <p class="eyebrow">Kept small on purpose</p>
      <h2>How we’ll work</h2>
    </div>
    <div class="principles-list">
      <p>No lectures or panels.</p>
      <p>Everyone contributes: ideas, food, and vibes.</p>
      <p>No such thing as a stupid question.</p>
      <p>Rotating hosts. This is your community too.</p>
    </div>
    <p class="home-founder-note">
      Founded by
      <a href="https://www.linkedin.com/in/lucy-hoyle-883381138" target="_blank" rel="noopener noreferrer">Lucy Hoyle</a>
      at Carta and
      <a href="https://www.linkedin.com/in/nicklafferty/" target="_blank" rel="noopener noreferrer">Nick Lafferty</a>
      at Profound.
    </p>
  </section>

  <AnnouncementFaq />
</BaseLayout>
