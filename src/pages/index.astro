---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ThreadCard from "@/components/ThreadCard.astro";
import { allTags, challenges, threads } from "@/data/forum";

const featuredThreads = [...threads].sort((a, b) => b.score - a.score).slice(0, 4);
const currentChallenge = challenges[0];
---

<BaseLayout
  title="Growth Circuit"
  description="A public forum and NYC supper club for marketing engineers. Bring Your Own Build."
  hideHeader
  bodyClass="home-ink-page"
>
  <div class="ink-hero">
    <div class="ink-hero__grid" aria-hidden="true"></div>
    <div class="ink-hero__glow" aria-hidden="true"></div>

    <header class="ink-header">
      <div class="shell ink-nav">
        <a class="brand" href="/" aria-label="Growth Circuit home">
          <span class="brand-mark brand-mark--light">GC</span>
          <span class="brand-word">Growth Circuit</span>
        </a>
        <nav class="ink-links" aria-label="Primary navigation">
          <a href="/questions">Forum</a>
          <a href="/challenges">Challenge</a>
          <a href="/nyc">Supper club</a>
        </nav>
        <div class="header-actions">
          <a class="button button--ghost-light" href="/auth">Sign in</a>
          <a class="button matcha" href="/submit">Submit a post</a>
        </div>
      </div>
    </header>

    <section class="shell ink-section">
      <div class="ink-intro">
        <p class="eyebrow eyebrow--live">Bring your own build</p>
        <h1 class="ink-title">
          Where marketing engineers build <span>in public</span>
        </h1>
        <p class="ink-lead">
          Growth Circuit is an open forum for tactical questions and build notes, plus a small NYC
          supper club for people who want to bring the work into the room.
        </p>
        <div class="hero-actions">
          <a class="button matcha" href="/submit">Submit a post</a>
          <a class="button button--ghost-light" href="/nyc">Apply for NYC</a>
        </div>
      </div>

      <div class="ink-ledger" aria-label="Community stats">
        <div class="ink-stat"><strong>{threads.length}</strong><span>seed threads live</span></div>
        <div class="ink-stat"><strong>12</strong><span>supper club seats</span></div>
        <div class="ink-stat"><strong>{currentChallenge.submissions}</strong><span>submissions in</span></div>
        <div class="ink-stat ink-stat--accent"><strong>1</strong><span>live BYOB challenge</span></div>
      </div>

      <a class="ink-ticker" href={`/challenges#${currentChallenge.slug}`}>
        <span class="ink-ticker__tag">This month</span>
        <span class="ink-ticker__rule" aria-hidden="true"></span>
        <span class="ink-ticker__title">{currentChallenge.title}</span>
        <span class="ink-ticker__cta">View prompt -></span>
      </a>
    </section>
  </div>

  <section class="shell page-grid home-forum-grid">
    <div>
      <div class="section-head">
        <div>
          <h2>Trending threads</h2>
          <p>First-hand questions and build notes from the marketing engineer edge.</p>
        </div>
        <a class="button" href="/questions">All questions</a>
      </div>
      <div class="thread-list">
        {featuredThreads.map((thread) => <ThreadCard thread={thread} />)}
      </div>
    </div>

    <aside class="side-stack">
      <section class="side-panel submit-cta">
        <p class="eyebrow">Open forum</p>
        <h2>Have a question or build note?</h2>
        <p>
          Start a dedicated post with the context people need to give useful answers.
        </p>
        <a class="button matcha" href="/submit">Create post</a>
      </section>
      <section class="side-panel">
        <h2>Topics</h2>
        <div class="topic-cloud">
          {allTags.map((tag) => <a class="tag" href={`/tags/${tag}`}>#{tag}</a>)}
        </div>
      </section>
      <section class="side-panel">
        <h2>Community rules</h2>
        <ul>
          <li>Show the build, not just the idea.</li>
          <li>Name what broke.</li>
          <li>Use names only with permission.</li>
          <li>No vendor pitch in the deep room.</li>
        </ul>
      </section>
    </aside>
  </section>
</BaseLayout>
