---
import "@/styles/site-theme.css";
import MemberPreview from "@/components/MemberPreview.astro";
import SiteHead from "@/components/SiteHead.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import CommunityLogoWall from "@/components/CommunityLogoWall.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import LumaCalendar from "@/components/LumaCalendar.astro";
import { featuredMembers, memberAnchor } from "@/data/featured-community";
import { HOME_DESCRIPTION, HOME_LEDE, HOME_TITLE } from "@/lib/page-copy";
---
<!doctype html>
<html lang="en"><head>
<SiteHead title={HOME_TITLE} appendSiteName={false} description={HOME_DESCRIPTION} />
</head><body class="gc-home" id="gc-site"><a class="skip" href="#main-content">Skip to content</a><main>
<div class="gc" data-homepage-scene>
  <div class="stage" data-stage="1" role="img" aria-label="An illustrated Brooklyn street beside Prospect Park, with the Manhattan skyline behind it, moving from morning to night as you scroll.">
    <canvas data-bg="1" aria-hidden="true"></canvas>
    <canvas data-fg="1" aria-hidden="true"></canvas>
  </div>

  <div class="flow">
    <section class="hero wrap" id="main-content">
      <SiteHeader />

      <h1 class="h1">Find the best NYC events for marketers</h1>
      <p class="lede">{HOME_LEDE}</p>

      <NewsletterSignup id="hero-newsletter" formOnly />
      <div class="cue" data-cue="1" aria-hidden="true">Scroll to walk through the park</div>
    </section>

    <section class="travel" data-travel="1">
      <div class="caption wrap" data-caption="1">
        <h2>Bringing you closer to your kind of people.</h2>
        <p>Starting in New York, but not stopping there.</p>
      </div>
    </section>

    <section class="panel">
      <CommunityLogoWall />
    </section>

    <div class="gap" data-gap1="1" aria-hidden="true"></div>

    <section id="events" data-board="1" class="wrap">
      <div class="board">
        <h2>Make room for a hello.</h2>
        <p>Find our next NYC gathering or online show &amp; tell. Come solo, bring a friend, and meet the people behind the work.</p>
        <LumaCalendar />
        <div class="boardlinks">
          <a class="pill" href="https://luma.com/growth-circuit">View the calendar and subscribe on Luma</a>
          <a class="pill ghost" href="/newsletter">Read the latest newsletter</a>
        </div>
      </div>
    </section>

    <div class="gap" data-gap2="1" aria-hidden="true"></div>

    <section class="panel" data-longpanel="1">
      <div class="long wrap">
        <div id="how-it-works">
          <h2 class="big">Growth is better in good company</h2>
          <div class="ways">
            <div class="way"><h3>Meet your people.</h3><p>Come to a public NYC event. Talk about what you’re working on. Leave with someone you want to keep in touch with.</p></div>
            <div class="way"><h3>Get another perspective.</h3><p>A question about your stack. An experiment that surprised you. WhatsApp is where the conversation carries on between events.</p></div>
            <div class="way"><h3>Bring what you’re building.</h3><p>Share the workflow, tool, or scrappy first version you’ve been working on. Find people who understand the problem and can compare notes.</p></div>
          </div>
        </div>

        <div class="commhead" id="community">
          <div>
            <h2 class="big">Meet the community</h2>
            <p class="intro">Meet some of the people you’ll find at our events and in the community.</p>
          </div>
          <a class="textlink" href="/people">Explore member projects</a>
        </div>
        <ul class="strip" data-strip="1">
          <li class="car" aria-hidden="true"></li>
          {featuredMembers.map((member) => <li class="stop" id={memberAnchor(member.name)} tabindex="-1">
            <a class="timeline-member-link" data-member-preview href={"github" in member ? `/people/${member.github}` : member.linkedin}>
              <span class="stopname">{member.name}</span>
              <span class="dot" aria-hidden="true"></span>
              <span class="stopinfo"><b>{member.company}</b>{member.detail}</span>
              <MemberPreview member={member} />
            </a>
          </li>)}
        </ul>

        <div class="built">
          <h2 class="big">Built by people doing the work.</h2>
          <div>
            <p class="intro">We’re Nick and Lucy. We started Growth Circuit to meet more people building things in marketing, growth, and AI. Come say hello.</p>
            <div class="hosts">
              <a href="https://www.linkedin.com/in/nicklafferty/">Nick Lafferty <span>Profound</span></a>
              <a href="https://www.linkedin.com/in/lucyjanehoyle">Lucy Hoyle <span>Carta</span></a>
            </div>
          </div>
        </div>

        <div class="faq">
          <h2 class="big">A few things you might be wondering.</h2>
          <div class="faqlist">
            <details><summary>Is this for marketers or engineers?<span class="plus" aria-hidden="true"></span></summary><p>Both, and anyone building growth systems. Your job title matters less than your interest in the work and willingness to share what you’re learning.</p></details>
            <details><summary>Do I have to live in New York?<span class="plus" aria-hidden="true"></span></summary><p>No. The newsletter includes NYC and virtual events, so you can find something to join from wherever you are. Our in-person gatherings are in New York.</p></details>
            <details><summary>Can I come to an event on my own?<span class="plus" aria-hidden="true"></span></summary><p>Yes! Public events are a way to meet people. Browse the events above for details and RSVP requirements, and come by yourself or bring a friend.</p></details>
            <details><summary>What happens after I subscribe?<span class="plus" aria-hidden="true"></span></summary><p>Confirm your email and we’ll send you the most recent list of events. A few days later, you’ll get an invitation to join us on WhatsApp. You can keep reading the newsletter whether or not you join the group.</p></details>
          </div>
        </div>
      </div>
    </section>

    <section class="closing" id="newsletter" data-closing="1">
      <div class="closetxt wrap">
        <h2 class="big">See you around the neighborhood.</h2>
        <NewsletterSignup id="closing-newsletter" formOnly />
      </div>
      <p class="foot wrap">Growth Circuit is run by <a href="https://www.linkedin.com/in/nicklafferty/">Nick Lafferty</a> at Profound and <a href="https://www.linkedin.com/in/lucyjanehoyle">Lucy Hoyle</a> at Carta.</p>
    </section>
  </div>
</div>
</main></body></html>
<style is:global>
@font-face{font-family:Parkinsans;font-style:normal;font-weight:300 800;font-display:swap;src:url("/fonts/parkinsans-variable.ttf") format("truetype")}

body{margin:0;background:#17313a}
a{color:inherit}
.gc{--ink:#17313a;--sky:#dceef5;--paper:#f7fcfd;--line:#6fb23f;--sun:#f6a93b;--moss:#2f6d52;position:relative;font-family:Parkinsans,"Avenir Next",Avenir,"Nunito Sans",system-ui,sans-serif;font-size:18px;line-height:1.5;color:var(--ink);overflow-x:clip;-webkit-font-smoothing:antialiased}
.gc *{box-sizing:border-box}
.gc :focus-visible{outline:3px solid var(--sun);outline-offset:3px;border-radius:4px}
.stage{position:sticky;top:0;height:100vh;margin-bottom:-100vh;overflow:hidden;z-index:0;background:var(--sky)}
.stage canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.flow{position:relative;z-index:1}
.gc-home .gc-header{background:transparent}.gc-home .gc-header .shell{width:100%}.gc-home .gc-nav{min-height:100px}.gc-home .gc-nav-menu a{text-decoration:none}
.wrap{width:min(100% - 64px,1240px);margin-inline:auto}

.nav{display:flex;align-items:center;gap:32px;padding:22px 0}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:19px;letter-spacing:-.01em;text-decoration:none;white-space:nowrap}
.brand-logo{display:block;width:44px;height:44px;flex-shrink:0;border-radius:50%;box-shadow:0 6px 20px rgba(23,49,58,.16)}
.navlinks{display:flex;gap:26px;margin-left:auto;font-size:16px}
.navlinks a{text-decoration:none;padding:6px 0}
.navlinks a:hover{text-decoration:underline;text-underline-offset:5px}
.pill{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 20px;border-radius:999px;background:var(--ink);color:#fff;font-weight:600;font-size:16px;text-decoration:none;border:0;cursor:pointer;font-family:inherit;white-space:nowrap;transition:transform .2s}
.pill:hover{transform:translateY(-1px)}

.hero{min-height:100vh;display:flex;flex-direction:column;position:relative}
.h1{margin:clamp(14px,3.4vh,44px) 0 0;font-weight:700;font-size:clamp(44px,min(6.7vw,11.2vh),104px);line-height:.98;letter-spacing:-.035em;max-width:13.5em;text-wrap:balance}
.lede{margin:clamp(14px,2.2vh,24px) 0 0;max-width:40em;font-size:clamp(16px,2.05vh,19px);line-height:1.42}
.signup{margin-top:clamp(14px,2.2vh,24px);display:flex;gap:8px;flex-wrap:wrap;max-width:520px}
.signup label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
.signup input{flex:1 1 220px;min-width:0;min-height:52px;padding:0 18px;border-radius:999px;border:2px solid var(--ink);background:#fff;color:var(--ink);font:inherit;font-size:17px}
.signup input::placeholder{color:#55717b}
.signup .pill{min-height:52px;flex:0 0 auto;padding:0 24px;font-size:17px}
.fine{margin:10px 0 0;font-size:14px;line-height:1.35}
.hero .fine{width:fit-content;max-width:100%;margin-left:-10px;padding:4px 10px;border-radius:10px;background:rgba(232,245,248,.92);position:relative;z-index:1}
.done{margin:clamp(14px,2.2vh,24px) 0 0;max-width:520px;padding:14px 20px;border-radius:18px;background:#fff;color:var(--ink);font-weight:600}
.cue{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);padding:8px 16px;border-radius:999px;background:var(--paper);font-size:15px;font-weight:600;white-space:nowrap;box-shadow:0 0 0 2px var(--ink)}

.travel{height:190vh;position:relative}
.caption{position:sticky;top:15vh;opacity:0;will-change:opacity,transform}
.caption h2{margin:0;font-weight:700;font-size:clamp(38px,min(5.6vw,10vh),88px);line-height:1;letter-spacing:-.03em;max-width:12em;text-wrap:balance}
.caption p{margin:16px 0 0;font-size:clamp(18px,1.8vw,24px);font-weight:500}

.panel{position:relative;background:var(--paper)}
.panel::before{content:"";position:absolute;left:0;right:0;top:-29px;height:30px;pointer-events:none;background-image:radial-gradient(circle,var(--paper) 1.6px,transparent 2.1px),radial-gradient(circle,var(--paper) 2.6px,transparent 3.1px),radial-gradient(circle,var(--paper) 4.1px,transparent 4.6px);background-size:12px 10px;background-repeat:repeat-x;background-position:0 0,6px 10px,0 20px}
.panel::after{content:"";position:absolute;left:0;right:0;bottom:-29px;height:30px;pointer-events:none;background-image:radial-gradient(circle,var(--paper) 4.1px,transparent 4.6px),radial-gradient(circle,var(--paper) 2.6px,transparent 3.1px),radial-gradient(circle,var(--paper) 1.6px,transparent 2.1px);background-size:12px 10px;background-repeat:repeat-x;background-position:0 0,6px 10px,0 20px}

.proof{padding:clamp(56px,8vw,104px) 0}
.proof h2{margin:0;font-weight:500;font-size:clamp(20px,2vw,26px);letter-spacing:-.01em}
.names{list-style:none;margin:18px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:2px clamp(20px,2.6vw,40px);font-weight:700;font-size:clamp(34px,5.4vw,80px);line-height:1.12;letter-spacing:-.03em}
.names a{text-decoration:none;color:var(--ink)}
.names a:hover{color:var(--moss)}

.gap{height:72vh}
.board{background:#0e2029;color:#fff;border-radius:28px;padding:clamp(28px,4.4vw,64px);position:relative;overflow:hidden}
.board h2{margin:0;font-weight:700;font-size:clamp(40px,6vw,92px);line-height:1;letter-spacing:-.03em}
.board>p{margin:16px 0 0;max-width:30em;font-size:clamp(17px,1.5vw,20px)}
.led{margin:clamp(24px,3.4vw,44px) 0 0;padding:clamp(8px,1.2vw,14px) clamp(14px,2vw,26px);border-radius:14px;background-color:#050d11;background-image:radial-gradient(circle,#16262d 1px,transparent 1.4px);background-size:6px 6px;font-family:Doto,"Courier New",monospace;font-weight:900;color:#ffc25e;text-shadow:0 0 9px rgba(255,180,70,.42);list-style:none}
.led li{border-bottom:1px solid #1f3640}
.led li:last-child{border-bottom:0}
.led a{display:grid;grid-template-columns:18px minmax(0,1.2fr) minmax(0,1fr) auto;gap:clamp(10px,1.6vw,24px);align-items:center;min-height:68px;padding:12px 0;text-decoration:none;font-size:clamp(21px,2.2vw,32px);line-height:1.08}
.led a:hover{color:#ffe7b5}
.lamp{width:14px;height:14px;border-radius:50%;background:var(--line);box-shadow:0 0 12px var(--line)}
.ledwhen{text-align:right;white-space:nowrap}
.boardlinks{display:flex;flex-wrap:wrap;gap:12px;margin-top:clamp(20px,2.6vw,30px)}
.boardlinks .pill{background:#fff;color:var(--ink);text-align:center;white-space:normal;padding:10px 20px;line-height:1.2}
.ghost{background:transparent!important;color:#fff!important;box-shadow:inset 0 0 0 2px #fff}

.long{padding:clamp(64px,9vw,128px) 0 clamp(64px,8vw,110px)}
.big{margin:0;font-weight:700;font-size:clamp(40px,6vw,92px);line-height:1;letter-spacing:-.03em;max-width:11em;text-wrap:balance}
.intro{margin:20px 0 0;max-width:32em;font-size:clamp(18px,1.6vw,22px)}
.ways{margin:clamp(34px,5vw,64px) 0 0;display:grid;gap:0}
.way{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(10px,3vw,48px);padding:clamp(20px,2.4vw,32px) 0;border-top:2px solid var(--ink);align-items:baseline}
.way h3{margin:0;font-weight:600;font-size:clamp(26px,3vw,42px);line-height:1.05;letter-spacing:-.02em}
.way p{margin:0;max-width:34em}

.commhead{margin-top:clamp(80px,11vw,160px);display:flex;flex-wrap:wrap;gap:20px 48px;align-items:flex-end;justify-content:space-between}
.commhead .intro{margin-top:16px}
.textlink{font-weight:600;text-underline-offset:5px;text-decoration-thickness:2px;display:inline-flex;align-items:center;min-height:44px}

.strip{--p:0;position:relative;margin-top:clamp(32px,4vw,52px);list-style:none;padding:0;display:grid;grid-template-columns:repeat(8,minmax(0,1fr))}
.strip::before{content:"";position:absolute;left:0;right:0;top:128px;height:8px;margin-top:-4px;border-radius:4px;background:var(--line)}
.car{position:absolute;top:128px;left:calc(var(--p)*(100% - 44px));width:44px;height:18px;margin-top:-9px;border-radius:7px;background:var(--ink);box-shadow:0 0 0 2px var(--paper);pointer-events:none;z-index:2}
.stop{position:relative;min-width:0}
.stop:has([data-open]){z-index:5}
.stop a{display:block;text-decoration:none;height:100%;padding-top:128px;position:relative}
.stopname{position:absolute;left:12px;top:86px;width:150px;transform-origin:0 100%;transform:rotate(-38deg);font-weight:700;font-size:18px;line-height:1.1;white-space:nowrap}
.dot{position:absolute;left:0;top:128px;width:24px;height:24px;margin-top:-12px;border-radius:50%;background:#fff;border:4px solid var(--ink);transition:background .15s;z-index:3}
.stop a:hover .dot,.stop a:focus-visible .dot{background:var(--sun)}
.stop a:hover .stopname{text-decoration:underline;text-underline-offset:4px}
.stopinfo{display:block;padding:24px 10px 0 0;font-size:15px;line-height:1.25}
.stopinfo b{display:block;font-weight:700;font-size:17px}

.built{margin-top:clamp(80px,11vw,160px);display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(20px,4vw,64px);align-items:end}
.built .intro{margin-top:0}
.hosts{display:flex;gap:14px 32px;flex-wrap:wrap;margin-top:18px;font-weight:600}
.hosts a{display:inline-flex;gap:8px;min-height:44px;align-items:center;text-underline-offset:5px;text-decoration-thickness:2px}
.hosts span{font-weight:400}

.faq{margin-top:clamp(80px,11vw,160px)}
.faq h2{font-size:clamp(34px,4.4vw,64px)}
.faqlist{margin-top:clamp(24px,3vw,40px);border-bottom:2px solid var(--ink)}
.faq details{border-top:2px solid var(--ink)}
.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;min-height:68px;padding:12px 0;font-weight:600;font-size:clamp(20px,2vw,28px);line-height:1.15;letter-spacing:-.01em}
.faq summary::-webkit-details-marker{display:none}
.plus{flex:0 0 22px;height:22px;position:relative;transition:transform .25s}
.plus::before,.plus::after{content:"";position:absolute;background:var(--ink);border-radius:2px}
.plus::before{left:0;right:0;top:10px;height:3px}
.plus::after{top:0;bottom:0;left:10px;width:3px}
.faq details[open] .plus{transform:rotate(45deg)}
.faq details p{margin:0;padding:0 40px 24px 0;max-width:40em}

.closing{min-height:170vh;position:relative;color:#fff;display:flex;flex-direction:column}
.closetxt{margin-top:clamp(96px,18vh,190px);position:sticky;top:clamp(40px,10vh,100px)}
.closetxt .big{max-width:9.5em;font-size:clamp(44px,min(6.7vw,11.2vh),104px)}
.closetxt .signup input{border-color:#fff}
.closetxt .signup .pill{background:var(--sun);color:var(--ink)}
.closetxt .done{color:var(--ink)}
.closetxt .fine,.closetxt .textlink{color:#fff}
.foot{margin-top:auto;padding:0 0 22px;font-size:14px;line-height:1.35;color:#fff}
.foot a{text-underline-offset:3px}

@media (max-width:900px){
.wrap{width:calc(100% - 40px)}
.way{grid-template-columns:minmax(0,1fr)}
.built{grid-template-columns:minmax(0,1fr)}
.strip{grid-template-columns:minmax(0,1fr);padding-left:2px}
.strip::before{left:9px;right:auto;top:10px;bottom:10px;width:8px;height:auto;margin-top:0}
.car{top:calc(10px + var(--p)*(100% - 44px));left:4px;width:18px;height:44px;margin-top:0;border-radius:7px}
.stop a{display:block;padding:0 0 26px 44px;min-height:64px}
.stopname{position:static;display:block;transform:none;white-space:normal;width:auto;font-size:21px}
.dot{left:1px;top:12px}
.stopinfo{padding:4px 0 0}
.stopinfo b{display:inline;font-size:15px}
.stopinfo b::after{content:", "}
.led a{grid-template-columns:16px minmax(0,1fr);row-gap:2px}
.led a>span:nth-child(3),.ledwhen{grid-column:2;text-align:left;font-size:18px;white-space:normal}
}
@media (max-width:820px){.navlinks{display:none}.nav .pill{margin-left:auto}}
@media (max-width:760px){
.brand-logo{width:34px;height:34px}
.nav{gap:12px;padding:16px 0}
.nav .pill{margin-left:auto;min-height:40px;font-size:15px;padding:0 14px}
.h1{font-size:clamp(40px,11.4vw,56px);margin-top:10px}
.lede{font-size:16px;margin-top:12px}
.signup{margin-top:14px}
.signup .pill{flex:1 1 100%}
.fine{font-size:13px;margin-top:8px}
.cue{bottom:14px;font-size:14px}
.closing{min-height:170vh}
}
@media (prefers-reduced-motion:reduce){.pill,.plus{transition:none}.pill:hover{transform:none}}

html{scroll-behavior:smooth}body{margin:0}.gc .shell{width:min(100% - 64px,1240px);margin-inline:auto}.gc .keep-together{white-space:nowrap}
.gc .community-companies{padding:72px 0;background:#e8f3f6}.gc .community-companies h2{text-align:center;margin:0 0 36px;font-size:18px;line-height:1.5;color:#4d6570}.gc .member-reveal img{max-width:100%}.gc .panel:has(.community-companies){--paper:#e8f3f6;z-index:3}
.gc .newsletter-inline{margin-top:24px;max-width:540px}.gc .newsletter-form>label:first-child{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
.gc .newsletter-form .signup-row input{border:2px solid var(--ink);border-radius:999px;padding:12px 18px;color:var(--ink);font-size:17px;min-height:52px}
.gc .signup-row button{border-radius:999px;background:var(--ink);color:#fff;font:inherit;font-size:17px;font-weight:600;padding:12px 24px;min-height:52px}
.gc .newsletter-consent{width:fit-content;background:rgba(232,245,248,.95);border-radius:8px;padding:6px 8px;color:var(--ink);font-size:13px}.gc .newsletter-status:not(:empty){background:var(--paper);color:var(--ink);padding:14px;border-radius:12px}
.gc .closetxt .signup-row button{background:var(--sun);color:var(--ink)}.gc .closetxt .newsletter-consent{background:rgba(14,32,41,.9);color:#fff;padding:8px 12px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.28)}.gc .closetxt .newsletter-consent input{accent-color:var(--sun)}.gc .board .luma-calendar{margin-top:32px}.gc .board .luma-calendar__link{display:none}
.gc .stop{scroll-margin-top:100px}.gc .stop:target{background:#e8f3f6;border-radius:8px}.gc .stop:focus-visible{outline:3px solid var(--sun)}
.skip{position:absolute;top:-80px;left:16px;z-index:10;background:white;padding:12px;color:#17313a}.skip:focus{top:12px}
@media(max-width:760px){.gc .shell{width:calc(100% - 40px)}.gc .community-companies{padding:40px 0}.gc .signup-row{flex-direction:column}.hero{min-height:max(900px,100svh)}.gc .hero .newsletter-inline{margin-top:14px}.gc .newsletter-consent{margin-top:8px}.gc .keep-together{white-space:normal}}
@media(max-width:760px){.gc .community-companies h2{text-align:left}.gc .community-companies h2 .keep-together{display:block}.boardlinks{display:grid;grid-template-columns:minmax(0,1fr)}.boardlinks .pill{width:100%;justify-content:center;text-align:center}}
@media(max-width:370px){.nav .brand{font-size:16px;gap:6px}.nav .pill{font-size:13px;padding:0 12px}.nav{gap:8px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

</style>
<script>
import "../scripts/homepage-scene.js";
</script>
