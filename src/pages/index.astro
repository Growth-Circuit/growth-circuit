---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ApplicationForm from "@/components/ApplicationForm";
---

<BaseLayout
  title="Growth Circuit"
  description="An intimate, invite-only community for Marketing Engineers based in New York City or nearby."
  hideHeader
  bodyClass="home-ink-page"
>
  <div class="ink-hero">
    <div class="ink-hero__grid" aria-hidden="true"></div>
    <div class="ink-hero__glow" aria-hidden="true"></div>

    <header class="ink-header">
      <div class="shell ink-nav">
        <a class="brand" href="/" aria-label="Growth Circuit home">
          <span class="brand-mark brand-mark--light">GC</span>
          <span class="brand-word">Growth Circuit</span>
        </a>
        <nav class="ink-links" aria-label="Primary navigation">
          <a href="/nyc">NYC community</a>
          <a href="#global">Global community</a>
        </nav>
        <div class="header-actions">
          <a class="button matcha" href="#apply">Apply for NYC</a>
        </div>
      </div>
    </header>

    <section class="shell ink-section">
      <div class="ink-intro">
        <p class="eyebrow eyebrow--live">Invite-only NYC community</p>
        <h1 class="ink-title">
          Think book club, but for <span>hacking not reading</span>
        </h1>
        <p class="ink-lead">
          An intimate, invite-only community for Marketing Engineers based in New York City or nearby.
          Once a month, one member sets a theme. Everyone goes away, builds something around it, then
          meets up a few weeks later to demo, discuss, and learn from each other.
        </p>
        <div class="hero-actions">
          <a class="button matcha" href="#apply">Apply for NYC</a>
          <a class="button button--ghost-light" href="#global">Not in NYC?</a>
        </div>
      </div>

      <div class="ink-ledger" aria-label="Community overview">
        <div class="ink-stat"><strong>Small</strong><span>quality over scale</span></div>
        <div class="ink-stat"><strong>NYC</strong><span>or nearby</span></div>
        <div class="ink-stat"><strong>Monthly</strong><span>rotating themes</span></div>
        <div class="ink-stat ink-stat--accent"><strong>Global</strong><span>community next</span></div>
      </div>

      <a class="ink-ticker" href="#global">
        <span class="ink-ticker__tag">Not in NYC?</span>
        <span class="ink-ticker__rule" aria-hidden="true"></span>
        <span class="ink-ticker__title">We are starting around one table, then opening a global community for everyone else.</span>
        <span class="ink-ticker__cta">Read note -></span>
      </a>
    </section>
  </div>

  <section class="shell page-grid home-forum-grid announcement-grid">
    <div class="side-panel announcement-panel">
      <p class="eyebrow">How it works</p>
      <h2>One theme. A little homework. A room full of builders.</h2>
      <p>
        One member sets a theme: a problem, a tool, or a question they want to explore. Everyone
        builds around it in their own time, then the group meets to demo, discuss, and learn.
      </p>
      <div class="ritual-list" aria-label="Community structure">
        <div><strong>Theme</strong><span>A member frames a problem, tool, or question</span></div>
        <div><strong>Build</strong><span>Everyone explores it in their own time</span></div>
        <div><strong>Meet</strong><span>The group demos, discusses, and learns together</span></div>
      </div>
      <div class="principle-list" aria-label="Format principles">
        <p class="eyebrow">Format principles</p>
        <ul>
          <li>No lectures, no panels.</li>
          <li>Everyone brings something: food and ideas.</li>
          <li>Distributed leadership: the host role rotates.</li>
          <li>Quality over scale. Kept intentionally small.</li>
        </ul>
      </div>
      <div class="founder-note">
        Founded by <a href="https://www.linkedin.com/in/lucy-hoyle-883381138" target="_blank" rel="noopener noreferrer">Lucy Hoyle</a> (Carta)
        and <a href="https://www.linkedin.com/in/nicklafferty/" target="_blank" rel="noopener noreferrer">Nick Lafferty</a> (Profound).
      </div>
    </div>

    <aside class="side-stack">
      <ApplicationForm client:load />
      <section class="side-panel" id="global">
        <p class="eyebrow">Global next</p>
        <h2>Not in New York?</h2>
        <p>
          The public community is still part of the plan. We are keeping the launch focused on the
          NYC group first, then we will open up a global space for people who want the prompts,
          sharebacks, and build notes without being in New York.
        </p>
      </section>
    </aside>
  </section>
</BaseLayout>
