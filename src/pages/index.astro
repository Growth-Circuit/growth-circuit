---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementFaq from "@/components/AnnouncementFaq.astro";
---

<BaseLayout
  title="Growth Circuit"
  description="A close-knit community for Marketing Engineers based in New York City."
  hideHeader
  bodyClass="home-ink-page"
>
  <div class="ink-hero">
    <div class="ink-hero__grid" aria-hidden="true"></div>
    <div class="ink-hero__glow" aria-hidden="true"></div>

    <header class="ink-header">
      <div class="shell ink-nav">
        <a class="brand" href="/" aria-label="Growth Circuit home">
          <span class="brand-mark brand-mark--light">GC</span>
          <span class="brand-word">Growth Circuit</span>
        </a>
        <nav class="ink-links" aria-label="Primary navigation">
          <a href="/nyc">NYC community</a>
          <a href="#global">Global community</a>
        </nav>
        <div class="header-actions">
          <a class="button matcha" href="/apply">Apply now</a>
        </div>
      </div>
    </header>

    <section class="shell ink-section">
      <div class="ink-intro">
        <p class="eyebrow eyebrow--live">NYC Marketing Engineer community</p>
        <h1 class="ink-title">
          Don't build alone. Connect with people who <span>actually understand what you do.</span>
        </h1>
        <p class="ink-lead">
          Growth Circuit is a close-knit community for Marketing Engineers based in New York City.
          Think book club, but for building.
        </p>
        <div class="hero-actions">
          <a class="button matcha" href="/apply">Apply now</a>
        </div>
      </div>

      <div class="ink-ledger" aria-label="Community overview">
        <div class="ink-stat"><strong>8</strong><span>people per cohort</span></div>
        <div class="ink-stat"><strong>NYC</strong><span>first cohort</span></div>
        <div class="ink-stat"><strong>4</strong><span>themes</span></div>
        <div class="ink-stat ink-stat--accent"><strong>Sept-Dec</strong><span>2026</span></div>
      </div>

      <a class="ink-ticker" href="#global">
        <span class="ink-ticker__tag">Outside NYC?</span>
        <span class="ink-ticker__rule" aria-hidden="true"></span>
        <span class="ink-ticker__title">We are testing the format in New York, then opening a global community for everyone else.</span>
        <span class="ink-ticker__cta">Read note -></span>
      </a>
    </section>
  </div>

  <section class="shell page-grid home-forum-grid announcement-grid">
    <div class="side-panel announcement-panel">
      <p class="eyebrow">How it works</p>
      <h2>One theme per month. Bring your own build. Iterate together.</h2>
      <p>
        Everyone gets a chance to shape the room, build in public, and learn from people solving
        similar problems from different angles.
      </p>
      <div class="ritual-list" aria-label="Community structure">
        <div><strong>Plan</strong><span>Everyone has a chance to set the monthly theme, whether it is a problem, tool, or question for the group to explore.</span></div>
        <div><strong>Build</strong><span>Bring your ideas and MVPs, plus snacks, to our monthly meetups.</span></div>
        <div><strong>Meet</strong><span>Get together for demos, workshops, and good food.</span></div>
      </div>
      <div class="principle-list" aria-label="Format principles">
        <p class="eyebrow">Guiding principles</p>
        <p>
          The most interesting work in marketing right now is happening in isolation. We wanted to
          create a space for builders to find their people.
        </p>
        <ul>
          <li>No lectures or panels.</li>
          <li>Everyone contributes: ideas, food, vibes.</li>
          <li>There is no such thing as a stupid question.</li>
          <li>Rotating hosts. This is your community as much as ours!</li>
        </ul>
      </div>
      <div class="founder-note">
        Founded by <a href="https://www.linkedin.com/in/lucy-hoyle-883381138" target="_blank" rel="noopener noreferrer">Lucy Hoyle</a> (Carta)
        and <a href="https://www.linkedin.com/in/nicklafferty/" target="_blank" rel="noopener noreferrer">Nick Lafferty</a> (Profound).
      </div>
    </div>

    <aside class="side-stack">
      <section class="side-panel application-teaser">
        <p class="eyebrow">Applications</p>
        <h2>First cohort: 8 people, 4 themes, Sept-Dec 2026.</h2>
        <p>
          We are selective because quality beats quantity. If you identify as a marketing
          engineer, this community was made for you.
        </p>
        <a class="button matcha" href="/apply">Apply now</a>
      </section>
      <section class="side-panel" id="global">
        <p class="eyebrow">Global next</p>
        <h2>What about people outside New York?</h2>
        <p>
          Our end goal is to build a global community for marketing engineers who want to swap
          ideas, notes, and demos, both in person and online. Our first cohort will be focused in
          NYC so we can test out the format and iterate before scaling.
        </p>
      </section>
    </aside>
  </section>

  <AnnouncementFaq />
</BaseLayout>
