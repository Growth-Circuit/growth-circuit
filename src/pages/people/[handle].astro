---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PROFILE_HANDLE_PATTERN, profileInitials } from "@/lib/public-profile";
const handle = String(Astro.params.handle || "").toLowerCase();
if (!PROFILE_HANDLE_PATTERN.test(handle) || !Astro.locals.supabase) return new Response("Not found", { status: 404 });
const { data: profile } = await Astro.locals.supabase.from("community_profiles").select("id,first_name,last_name,handle,headline,bio,location,website_url,community_projects(id,title,description,url,kind,position)").eq("handle", handle).eq("profile_state", "published").eq("profile_moderation_state", "visible").order("position", { referencedTable: "community_projects" }).maybeSingle();
if (!profile) return new Response("Not found", { status: 404 });
const fullName = `${profile.first_name} ${profile.last_name}`;
const projects = profile.community_projects || [];
const isOwner = Astro.locals.communityIdentity.user?.id === profile.id;
---
<BaseLayout title={fullName} description={profile.headline} path={`/people/${handle}`} bodyClass="sky-page pivot-page" jsonLd={[{ "@context": "https://schema.org", "@type": "Person", name: fullName, url: `https://growthcircuit.club/people/${handle}`, description: profile.bio, sameAs: profile.website_url ? [profile.website_url] : undefined }]}>
  <section class="shell public-profile-hero">
    <div class="public-profile-hero__avatar">{profileInitials(profile.first_name, profile.last_name)}</div>
    <div><p class="eyebrow">@{profile.handle}</p><h1>{fullName}</h1><p class="public-profile-headline">{profile.headline}</p><p class="public-profile-bio">{profile.bio}</p><div class="public-profile-meta">{profile.location && <span>{profile.location}</span>}{profile.website_url && <a href={profile.website_url} target="_blank" rel="noopener noreferrer">Website ↗</a>}{isOwner && <a href="/people/edit">Edit profile →</a>}</div></div>
  </section>
  <section class="shell public-projects" aria-labelledby="projects-title"><div class="public-projects__heading"><p class="eyebrow">Build shelf</p><h2 id="projects-title">Projects</h2></div>
    {projects.length === 0 ? <p class="profile-project-empty">Nothing here yet.</p> : <div class="project-shelf">{projects.map((project, index) => <a class="project-shelf-card" href={project.url} target="_blank" rel="noopener noreferrer"><span>{String(index + 1).padStart(2, "0")} · {project.kind}</span><h3>{project.title}</h3><p>{project.description}</p><strong>Open project ↗</strong></a>)}</div>}
  </section>
</BaseLayout>
