---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profileInitials } from "@/lib/public-profile";

const { data } = Astro.locals.supabase
  ? await Astro.locals.supabase.from("community_profiles").select("id,first_name,last_name,handle,headline,bio,location,community_projects(id,title,kind)").eq("profile_state", "published").eq("profile_moderation_state", "visible").order("published_at", { ascending: false })
  : { data: [] };
const profiles = data || [];
const signedIn = Boolean(Astro.locals.communityIdentity.user);
---

<BaseLayout title="People + projects" description="Growth Circuit members, their projects, and what they have shipped." path="/people" bodyClass="sky-page pivot-page">
  <section class="shell listing-hero people-directory-hero">
    <p class="eyebrow">Growth Circuit</p>
    <h1>Who’s building what</h1>
    <p>Growth Circuit members, their projects, and what they have shipped. Find someone to steal ideas from, or let them find you.</p>
    <div class="profile-hero-actions"><a class="button matcha" href={signedIn ? "/people/edit" : "/people/claim"}>{signedIn ? "Edit your profile" : "Claim your profile"}</a>{Astro.locals.communityIdentity.role === "admin" && <a class="pivot-text-link" href="/people/admin">Moderate profiles →</a>}</div>
  </section>

  <section class="shell public-directory" aria-label="People and projects">
    {profiles.length === 0 ? <div class="directory-empty"><p>Nobody here yet. Claim the first profile.</p><a href="/people/claim">Claim your profile →</a></div> : <div class="public-profile-grid">
      {profiles.map((profile) => <a class="public-profile-card" href={`/people/${profile.handle}`}>
        <div class="public-profile-card__top"><span>@{profile.handle}</span><span>{profile.location || "Growth Circuit"}</span></div>
        <div class="public-profile-card__identity"><div class="profile-preview__avatar">{profileInitials(profile.first_name, profile.last_name)}</div><div><h2>{profile.first_name} {profile.last_name}</h2><p>{profile.headline}</p></div></div>
        <p class="public-profile-card__bio">{profile.bio}</p>
        <div class="public-profile-card__projects"><span>{profile.community_projects?.length || 0} project{profile.community_projects?.length === 1 ? "" : "s"}</span>{profile.community_projects?.slice(0, 2).map((project) => <strong>{project.title}</strong>)}</div>
      </a>)}
    </div>}
  </section>
</BaseLayout>
