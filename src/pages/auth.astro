---
import AuthForm from "@/components/AuthForm";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSafeNextPath } from "@/lib/community-auth";

const nextPath = getSafeNextPath(Astro.url.searchParams.get("next"));
const needsProfile = Astro.url.searchParams.get("complete") === "1"
  && Boolean(Astro.locals.communityIdentity.user)
  && !Astro.locals.communityIdentity.profile;
if (Astro.locals.communityIdentity.profile && !needsProfile) {
  return Astro.redirect(nextPath, 303);
}
---

<BaseLayout
  title="Sign In"
  description="Sign in or create a Growth Circuit account."
  path="/auth"
  noindex
>
  <section class="shell auth-page">
    <div>
      <p class="eyebrow">Growth Circuit</p>
      <h1>{needsProfile ? "Tell us your name." : "Claim your profile"}</h1>
      <p class="lead">
        {needsProfile
          ? "Your name will appear on the public profile you choose to publish."
          : "Sign in with your email. Once you are in, you can fill out your profile and add projects you have shipped."}
      </p>
    </div>
    <AuthForm
      client:load
      csrfToken={Astro.locals.csrfToken}
      nextPath={nextPath}
      initialMode={needsProfile ? "profile" : "signin"}
      signupEnabled={Astro.locals.publicProfilesEnabled}
    />
  </section>
</BaseLayout>
