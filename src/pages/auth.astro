---
import AuthForm from "@/components/AuthForm";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sign In"
  description="Sign in or create a Growth Circuit account."
  path="/auth"
  noindex
>
  <section class="shell auth-page">
    <div>
      <p class="eyebrow">Light auth</p>
      <h1>Email and password for now.</h1>
      <p class="lead">
        Account features are parked while the announcement focuses on supper club applications.
        The wider community layer will come later.
      </p>
    </div>
    <AuthForm client:load />
  </section>
</BaseLayout>
