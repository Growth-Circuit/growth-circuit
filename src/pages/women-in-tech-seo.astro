---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Join Growth Circuit"
  description="A community for marketers, engineers, and builders making growth systems with AI."
  noindex
  hideHeader
  bodyClass="webinar-page sky-page"
>
  <section class="webinar-landing">
    <div class="signal signal--one" aria-hidden="true"></div>
    <div class="signal signal--two" aria-hidden="true"></div>

    <header class="webinar-header">
      <a class="webinar-brand" href="/" aria-label="Growth Circuit home">
        <img src="/growth-circuit-icon.svg" alt="" width="48" height="48" />
        <span>Growth Circuit</span>
      </a>
      <p>Women in Tech SEO</p>
    </header>

    <div class="webinar-grid">
      <div class="webinar-copy">
        <p class="talk-note">Thanks for coming to my talk :)</p>
        <h1>Keep building marketing agents with us.</h1>
        <p class="lede">
          Growth Circuit is a community for marketers, engineers, and builders turning AI workflows into real growth systems.
        </p>

        <div class="reasons" aria-label="What you will find in Growth Circuit">
          <p><span>01</span> Honest build breakdowns</p>
          <p><span>02</span> Smart operator conversations</p>
          <p><span>03</span> NYC events and a global community</p>
        </div>
      </div>

      <aside class="join-card" aria-labelledby="join-title">
        <div class="qr-frame">
          <img
            src="/women-in-tech-seo-qr.png"
            alt="QR code to join the Growth Circuit community"
            width="1155"
            height="1155"
          />
        </div>
        <h2 id="join-title">Scan to join</h2>
        <p>Come compare notes with people doing the work.</p>
      </aside>
    </div>

    <footer class="webinar-footer">
      <p>Hosted by Nick Lafferty + Lucy Hoyle</p>
      <p>growthcircuit.club</p>
    </footer>
  </section>
</BaseLayout>

<style>
  :global(.webinar-page) {
    background: #dceef5;
  }

  :global(.webinar-page::before),
  :global(.webinar-page > .footer) {
    display: none;
  }

  .webinar-landing {
    --navy: #17313a;
    --blue: #dceef5;
    --cloud: #f7fcfd;
    --green: #738d56;
    --coral: #d36b5a;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 86% 6%, rgba(255, 255, 255, 0.96), transparent 24%),
      linear-gradient(145deg, var(--blue) 0%, #e9f5f7 62%, #c7e3ea 100%);
    padding: clamp(22px, 3vw, 44px) clamp(22px, 5vw, 76px) 24px;
    color: var(--navy);
  }

  .webinar-header,
  .webinar-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .webinar-header {
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(23, 49, 58, 0.18);
  }

  .webinar-header > p,
  .webinar-footer p {
    margin: 0;
    font-size: 14px;
    font-weight: 720;
  }

  .webinar-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 800;
  }

  .webinar-brand img {
    width: 42px;
    height: 42px;
  }

  .webinar-grid {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(1320px, 100%);
    min-height: calc(100svh - 170px);
    margin: 0 auto;
    grid-template-columns: minmax(0, 1.3fr) minmax(340px, 0.7fr);
    gap: clamp(48px, 8vw, 130px);
    align-items: center;
    padding: clamp(48px, 7vh, 90px) 0;
  }

  .webinar-copy {
    max-width: 820px;
  }

  .talk-note {
    margin: 0 0 18px;
    color: var(--green);
    font-size: clamp(17px, 1.5vw, 22px);
    font-weight: 780;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(58px, 7.4vw, 122px);
    font-weight: 820;
    line-height: 0.88;
    letter-spacing: -0.067em;
  }

  .lede {
    max-width: 720px;
    margin: 30px 0 0;
    font-size: clamp(18px, 1.8vw, 25px);
    line-height: 1.45;
  }

  .reasons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 34px;
    padding-top: 22px;
    border-top: 1px solid rgba(23, 49, 58, 0.18);
  }

  .reasons p {
    margin: 0;
    font-size: 14px;
    font-weight: 680;
  }

  .reasons span {
    margin-right: 6px;
    color: var(--green);
  }

  .join-card {
    position: relative;
    justify-self: end;
    width: min(100%, 470px);
    border: 1px solid rgba(23, 49, 58, 0.15);
    background: rgba(247, 252, 253, 0.78);
    padding: clamp(20px, 2.5vw, 34px);
    box-shadow: 0 30px 80px rgba(45, 91, 103, 0.16);
    transform: rotate(1.2deg);
  }

  .qr-frame {
    background: #fff;
    padding: 10px;
  }

  .qr-frame img {
    width: 100%;
    height: auto;
  }

  .join-card h2 {
    margin: 24px 0 4px;
    font-size: clamp(32px, 3vw, 48px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .join-card p {
    margin: 10px 0 0;
    color: rgba(23, 49, 58, 0.72);
    font-size: 16px;
    line-height: 1.45;
  }

  .webinar-footer {
    padding-top: 18px;
    border-top: 1px solid rgba(23, 49, 58, 0.18);
    color: rgba(23, 49, 58, 0.72);
  }

  .signal {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .signal--one {
    top: 23%;
    right: -110px;
    width: 330px;
    height: 330px;
    border: 60px solid rgba(115, 141, 86, 0.13);
  }

  .signal--two {
    bottom: -150px;
    left: 37%;
    width: 280px;
    height: 280px;
    border: 45px solid rgba(211, 107, 90, 0.1);
  }

  @media (max-width: 820px) {
    .webinar-landing {
      padding: 18px 18px 22px;
    }

    .webinar-grid {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 38px;
      padding: 48px 0 42px;
    }

    h1 {
      font-size: clamp(52px, 15vw, 82px);
    }

    .join-card {
      justify-self: center;
      width: min(100%, 440px);
      transform: none;
    }

    .webinar-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }

  @media (max-width: 480px) {
    .webinar-header > p {
      max-width: 110px;
      text-align: right;
    }

    .reasons {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .join-card {
      transform: none;
    }
  }
</style>
