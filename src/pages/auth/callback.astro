---
import { getSafeNextPath } from "@/lib/community-auth";

const target = new URL("/auth/confirm", Astro.url.origin);
const code = Astro.url.searchParams.get("code");
if (code) target.searchParams.set("code", code);
target.searchParams.set("next", getSafeNextPath(Astro.url.searchParams.get("next")));
return Astro.redirect(`${target.pathname}${target.search}`, 303);
---
