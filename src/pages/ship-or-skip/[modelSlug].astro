---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  modelScorecards,
  modelReviews,
  rubricAreas,
  getTaskBySlug,
  formatRunDate,
  formatCost,
  formatAgreement,
  type ModelScorecard,
} from "@/data/ship-or-skip";
import { breadcrumbJsonLd } from "@/lib/seo";

export const prerender = true;

export function getStaticPaths() {
  return modelScorecards.map((scorecard) => ({
    params: { modelSlug: scorecard.modelSlug },
    props: { scorecard },
  }));
}

interface Props {
  scorecard: ModelScorecard;
}

const { scorecard } = Astro.props;
const review = modelReviews.find((r) => r.modelSlug === scorecard.modelSlug);

const shipCount = scorecard.taskScores.filter((ts) => ts.verdict === "ship").length;
const skipCount = scorecard.taskScores.filter((ts) => ts.verdict === "skip").length;
const avgEditMinutes = Math.round(scorecard.taskScores.reduce((sum, ts) => sum + ts.editMinutes, 0) / scorecard.taskScores.length);

const description = review?.oneLineVerdict || `Ship or Skip evaluation of ${scorecard.model} for GTM tasks.`;
---

<BaseLayout
  title={`${scorecard.model} | Ship or Skip`}
  description={description}
  path={`/ship-or-skip/${scorecard.modelSlug}`}
  bodyClass="sky-page pivot-page"
  jsonLd={[breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Ship or Skip", path: "/ship-or-skip" },
    { name: scorecard.model, path: `/ship-or-skip/${scorecard.modelSlug}` },
  ])]}
>
  <article class="shell sos-model-page">
    <p class="sos-back-link"><a href="/ship-or-skip">All models</a></p>

    <header class="sos-model-hero">
      <p class="eyebrow">Model evaluation</p>
      <h1>{scorecard.model}</h1>
      {review?.isPlaceholder && (
        <p class="sos-placeholder-notice">Example data. Replace after first real run.</p>
      )}
      {review && <p class="sos-model-verdict">{review.oneLineVerdict}</p>}

      <div class="sos-model-stats">
        <div class="sos-stat sos-stat-ship">
          <span class="sos-stat-value">{shipCount}</span>
          <span class="sos-stat-label">Ships</span>
        </div>
        <div class="sos-stat sos-stat-skip">
          <span class="sos-stat-value">{skipCount}</span>
          <span class="sos-stat-label">Skips</span>
        </div>
        <div class="sos-stat">
          <span class="sos-stat-value">{avgEditMinutes}m</span>
          <span class="sos-stat-label">Avg edit</span>
        </div>
        <div class="sos-stat">
          <span class="sos-stat-value">{formatCost(scorecard.costPerTask)}</span>
          <span class="sos-stat-label">Cost/task</span>
        </div>
        <div class="sos-stat">
          <span class="sos-stat-value">{formatAgreement(scorecard.judgeAgreement)}</span>
          <span class="sos-stat-label">Agreement</span>
        </div>
      </div>

      <p class="sos-model-run-date">
        Evaluated <time datetime={scorecard.runDate}>{formatRunDate(scorecard.runDate)}</time>
      </p>
    </header>

    <section class="sos-model-section" aria-labelledby="task-results-title">
      <h2 id="task-results-title">Task Results</h2>

      <div class="sos-task-results">
        {scorecard.taskScores.map((taskScore) => {
          const task = getTaskBySlug(taskScore.task);
          return (
            <div class={`sos-task-card sos-task-${taskScore.verdict}`}>
              <div class="sos-task-header">
                <h3>{task?.name || taskScore.task}</h3>
                <span class={`sos-task-verdict sos-verdict-${taskScore.verdict}`}>
                  {taskScore.verdict === "ship" ? "Ship" : "Skip"}
                </span>
              </div>
              <p class="sos-task-description">{task?.description}</p>
              <div class="sos-task-meta">
                <span><strong>{taskScore.editMinutes}</strong> min edit time</span>
              </div>
              <div class="sos-rubric-scores">
                {rubricAreas.map((area) => {
                  const score = taskScore.rubricScores.find((rs) => rs.area === area.slug);
                  return (
                    <span class={`sos-rubric-pill sos-rubric-${score?.verdict || "skip"}`} title={area.description}>
                      {area.name}
                    </span>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="sos-model-section" aria-labelledby="rubric-breakdown-title">
      <h2 id="rubric-breakdown-title">Rubric Breakdown</h2>
      <p class="sos-section-description">How {scorecard.model} performed across the seven evaluation areas.</p>

      <div class="sos-rubric-breakdown">
        {rubricAreas.map((area) => {
          const shipTasks = scorecard.taskScores.filter((ts) =>
            ts.rubricScores.find((rs) => rs.area === area.slug)?.verdict === "ship"
          ).length;
          const percentage = Math.round((shipTasks / scorecard.taskScores.length) * 100);
          return (
            <div class="sos-rubric-row">
              <div class="sos-rubric-info">
                <strong>{area.name}</strong>
                <span>{area.description}</span>
              </div>
              <div class="sos-rubric-bar-wrapper">
                <div class="sos-rubric-bar" style={`width: ${percentage}%`}></div>
              </div>
              <span class="sos-rubric-percentage">{percentage}%</span>
            </div>
          );
        })}
      </div>
    </section>

    {review && (review.xLink || review.linkedInLink) && (
      <section class="sos-model-section" aria-labelledby="share-title">
        <h2 id="share-title">Read the Full Review</h2>
        <div class="sos-share-links">
          {review.xLink && (
            <a href={review.xLink} target="_blank" rel="noopener" class="sos-share-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              Read on X
            </a>
          )}
          {review.linkedInLink && (
            <a href={review.linkedInLink} target="_blank" rel="noopener" class="sos-share-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Read on LinkedIn
            </a>
          )}
        </div>
      </section>
    )}

    <div class="sos-model-nav">
      <a href="/ship-or-skip" class="button">View all models</a>
    </div>
  </article>
</BaseLayout>

<style>
  .sos-model-page {
    padding-bottom: 100px;
  }

  .sos-back-link {
    margin: 40px 0 0;
    font-size: 13px;
    font-weight: 700;
  }

  .sos-back-link a {
    color: var(--sky-muted);
    text-decoration: none;
  }

  .sos-back-link a:hover {
    color: var(--pivot-navy);
  }

  .sos-back-link a::before {
    content: "← ";
  }

  .sos-model-hero {
    padding: clamp(40px, 6vw, 80px) 0;
    border-bottom: 1px solid var(--pivot-line);
  }

  .sos-model-hero h1 {
    margin: 14px 0 20px;
    color: var(--pivot-navy);
    font-size: clamp(48px, 7vw, 86px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .sos-placeholder-notice {
    display: inline-block;
    margin-bottom: 16px;
    padding: 6px 12px;
    border: 1px solid var(--sky-coral);
    border-radius: 6px;
    background: rgba(212, 119, 98, 0.1);
    color: var(--sky-coral);
    font-size: 13px;
    font-weight: 700;
  }

  .sos-model-verdict {
    max-width: 600px;
    margin: 0 0 32px;
    color: var(--sky-muted);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.5;
  }

  .sos-model-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 24px;
  }

  .sos-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 80px;
    padding: 16px 20px;
    border: 1px solid var(--pivot-line);
    border-radius: 10px;
    background: white;
  }

  .sos-stat-ship {
    background: rgba(99, 140, 114, 0.1);
    border-color: rgba(99, 140, 114, 0.3);
  }

  .sos-stat-skip {
    background: rgba(212, 119, 98, 0.1);
    border-color: rgba(212, 119, 98, 0.3);
  }

  .sos-stat-value {
    color: var(--pivot-navy);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .sos-stat-ship .sos-stat-value {
    color: var(--sky-green);
  }

  .sos-stat-skip .sos-stat-value {
    color: var(--sky-coral);
  }

  .sos-stat-label {
    color: var(--sky-muted);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sos-model-run-date {
    margin: 0;
    color: var(--sky-muted);
    font-size: 14px;
  }

  .sos-model-section {
    padding: clamp(48px, 6vw, 80px) 0;
    border-bottom: 1px solid var(--pivot-line);
  }

  .sos-model-section h2 {
    margin: 0 0 12px;
    color: var(--pivot-navy);
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.03em;
  }

  .sos-section-description {
    max-width: 600px;
    margin: 0 0 32px;
    color: var(--sky-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .sos-task-results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .sos-task-card {
    border: 1px solid var(--pivot-line);
    border-radius: 14px;
    background: white;
    padding: 24px;
    transition: transform 160ms ease;
  }

  .sos-task-card:hover {
    transform: translateY(-2px);
  }

  .sos-task-ship {
    border-left: 4px solid var(--sky-green);
  }

  .sos-task-skip {
    border-left: 4px solid var(--sky-coral);
  }

  .sos-task-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .sos-task-header h3 {
    margin: 0;
    color: var(--pivot-navy);
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .sos-task-verdict {
    flex-shrink: 0;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sos-verdict-ship {
    background: rgba(99, 140, 114, 0.15);
    color: var(--sky-green);
  }

  .sos-verdict-skip {
    background: rgba(212, 119, 98, 0.15);
    color: var(--sky-coral);
  }

  .sos-task-description {
    margin: 0 0 16px;
    color: var(--sky-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .sos-task-meta {
    margin-bottom: 16px;
    color: var(--sky-muted);
    font-size: 13px;
  }

  .sos-task-meta strong {
    color: var(--pivot-navy);
  }

  .sos-rubric-scores {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sos-rubric-pill {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 650;
  }

  .sos-rubric-ship {
    background: rgba(99, 140, 114, 0.12);
    color: var(--sky-green);
  }

  .sos-rubric-skip {
    background: rgba(212, 119, 98, 0.12);
    color: var(--sky-coral);
  }

  .sos-rubric-breakdown {
    display: grid;
    gap: 16px;
  }

  .sos-rubric-row {
    display: grid;
    grid-template-columns: 200px 1fr 60px;
    gap: 20px;
    align-items: center;
  }

  .sos-rubric-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sos-rubric-info strong {
    color: var(--pivot-navy);
    font-size: 15px;
  }

  .sos-rubric-info span {
    color: var(--sky-muted);
    font-size: 12px;
  }

  .sos-rubric-bar-wrapper {
    height: 12px;
    border-radius: 6px;
    background: rgba(23, 49, 58, 0.08);
    overflow: hidden;
  }

  .sos-rubric-bar {
    height: 100%;
    border-radius: 6px;
    background: var(--sky-green);
    transition: width 300ms ease;
  }

  .sos-rubric-percentage {
    text-align: right;
    color: var(--pivot-navy);
    font-size: 14px;
    font-weight: 700;
  }

  .sos-share-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .sos-share-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border: 1px solid var(--pivot-line);
    border-radius: 8px;
    background: white;
    color: var(--pivot-navy);
    font-size: 14px;
    font-weight: 700;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .sos-share-link:hover {
    background: var(--pivot-blue);
    border-color: rgba(23, 49, 58, 0.2);
  }

  .sos-model-nav {
    padding-top: 48px;
    text-align: center;
  }

  @media (max-width: 760px) {
    .sos-model-stats {
      gap: 12px;
    }

    .sos-stat {
      min-width: 70px;
      padding: 12px 14px;
    }

    .sos-stat-value {
      font-size: 22px;
    }

    .sos-rubric-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .sos-rubric-percentage {
      text-align: left;
    }
  }

  @media (max-width: 620px) {
    .sos-model-hero h1 {
      font-size: 42px;
    }

    .sos-task-results {
      grid-template-columns: 1fr;
    }
  }
</style>
