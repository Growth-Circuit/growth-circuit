---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementHold from "@/components/AnnouncementHold.astro";
import { threads } from "@/data/forum";

export const prerender = true;

export function getStaticPaths() {
  return threads
    .filter((thread) => thread.type !== "build")
    .map((thread) => ({
      params: { slug: thread.slug },
      props: { thread },
    }));
}

const { thread } = Astro.props;

if (!thread) {
  return Astro.redirect("/questions");
}
---

<BaseLayout
  title="Question Archive"
  description="Growth Circuit question pages are paused while the announcement focuses on the NYC Marketing Engineer community."
  path={`/questions/${thread.slug}`}
  noindex
>
  <AnnouncementHold
    eyebrow="Coming later"
    title="The public question archive is hidden for launch."
    description="This page still exists in the scaffold, but the announcement is focused on NYC community applications first."
  />
</BaseLayout>
