---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import { listPublishedJobsIssues } from "@/lib/jobs-issues";
import { mergeArchiveIssues } from "@/lib/newsletter-archive";
import { formatNewsletterIssueDate, listPublishedNewsletterIssues } from "@/lib/newsletter-issues";
import { NEWSLETTER_DESCRIPTION } from "@/lib/page-copy";
import { breadcrumbJsonLd } from "@/lib/seo";

export const prerender = true;

const [events, jobs] = await Promise.all([listPublishedNewsletterIssues(), listPublishedJobsIssues()]);
const issues = mergeArchiveIssues(events, jobs);
const description = NEWSLETTER_DESCRIPTION;
---

<BaseLayout
  title="Newsletter"
  description={description}
  path="/newsletter"
  bodyClass="sky-page pivot-page"
  jsonLd={[breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Newsletter", path: "/newsletter" }])]}
>
  <section class="shell listing-hero newsletter-archive-hero">
    <p class="eyebrow">Growth Circuit newsletter</p>
    <h1>Catch up on past editions of our newsletter</h1>
  </section>

  <section class="shell newsletter-archive" aria-label="Newsletter issues">
    <nav class="newsletter-filter" aria-label="Filter issues">
      <a href="/newsletter" data-filter="all" aria-current="page">All</a>
      <a href="/newsletter?type=events" data-filter="events">Events</a>
      <a href="/newsletter?type=jobs" data-filter="jobs">Jobs</a>
    </nav>
    {
      issues.length ? (
        <ol class="newsletter-issue-list">
          {issues.map((issue) => (
            <li data-issue-type={issue.kind}>
              <a class:list={["newsletter-issue-card", `newsletter-issue-card--${issue.kind}`]} href={issue.path}>
                <p class="eyebrow">
                  <time datetime={issue.publishedAt}>{formatNewsletterIssueDate(issue.publishedAt)}</time>
                </p>
                <p class="newsletter-issue-type">{issue.kind === "jobs" ? "Jobs" : "Events"}</p>
                <h2>{issue.title}</h2>
                <p>{issue.description}</p>
                <span>Read this issue →</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <div class="directory-empty">
          <p>No issues in the archive yet. The weekly shortlist starts in your inbox.</p>
          <a href="#newsletter">Subscribe free →</a>
        </div>
      )
    }
    <p class="newsletter-filter-empty" hidden>No issues in this view yet.</p>
  </section>

  <NewsletterSignup adaptive />
  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var raw = params.get("type");
      var type = raw === "jobs" || raw === "events" ? raw : "all";
      var filters = document.querySelectorAll(".newsletter-filter [data-filter]");
      for (var i = 0; i < filters.length; i++) {
        var link = filters[i];
        if (link.getAttribute("data-filter") === type) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
      var items = document.querySelectorAll(".newsletter-issue-list > li[data-issue-type]");
      var visible = 0;
      for (var j = 0; j < items.length; j++) {
        var item = items[j];
        var show = type === "all" || item.getAttribute("data-issue-type") === type;
        if (show) {
          item.removeAttribute("hidden");
          visible++;
        } else {
          item.setAttribute("hidden", "");
        }
      }
      var empty = document.querySelector(".newsletter-filter-empty");
      if (empty) {
        if (type !== "all" && visible === 0) empty.removeAttribute("hidden");
        else empty.setAttribute("hidden", "");
      }
      var nodes = document.querySelectorAll("[data-copy-all]");
      for (var n = 0; n < nodes.length; n++) {
        var next = nodes[n].getAttribute("data-copy-" + type);
        if (next) nodes[n].textContent = next;
      }
    })();
  </script>
</BaseLayout>
