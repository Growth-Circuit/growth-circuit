---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ApplicationForm from "@/components/ApplicationForm";
---

<BaseLayout
  title="NYC Community"
  description="Apply for Growth Circuit's intimate, invite-only community for Marketing Engineers based in New York City or nearby."
  path="/nyc"
>
  <section class="shell nyc-hero">
    <div class="nyc-copy">
      <p class="eyebrow">Invite-only NYC community</p>
      <h1>Think book club, but for hacking not reading.</h1>
      <p class="lead">
        Growth Circuit is an intimate, invite-only community for Marketing Engineers based in New
        York City or nearby. Once a month, one member sets a theme. Everyone builds around it, then
        meets up a few weeks later to demo, discuss, and learn from each other.
      </p>
      <div class="hero-actions">
        <a class="button matcha" href="#apply">Apply to join</a>
        <a class="button" href="/#global">Global community next</a>
      </div>
      <div class="ritual-list" aria-label="Community structure">
        <div><strong>Theme</strong><span>A problem, tool, or question to explore</span></div>
        <div><strong>Build</strong><span>Members make something in their own time</span></div>
        <div><strong>Meet</strong><span>Demos, discussion, and shared learning</span></div>
        <div><strong>Rotate</strong><span>The host role moves around the group</span></div>
      </div>
      <div class="side-panel principle-list">
        <p class="eyebrow">Format principles</p>
        <ul>
          <li>No lectures, no panels.</li>
          <li>Everyone brings something: food and ideas.</li>
          <li>Distributed leadership: the host role rotates so Lucy and Nick are not always on.</li>
          <li>Quality over scale. Kept intentionally small.</li>
        </ul>
        <p>
          Founded by <a href="https://www.linkedin.com/in/lucy-hoyle-883381138" target="_blank" rel="noopener noreferrer">Lucy Hoyle</a> (Carta)
          and <a href="https://www.linkedin.com/in/nicklafferty/" target="_blank" rel="noopener noreferrer">Nick Lafferty</a> (Profound).
        </p>
      </div>
    </div>

    <ApplicationForm client:load />
  </section>
</BaseLayout>
