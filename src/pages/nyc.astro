---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ApplicationForm from "@/components/ApplicationForm";
---

<BaseLayout
  title="NYC Supper Club"
  description="Apply for Growth Circuit's intimate NYC supper club for marketing engineers."
  path="/nyc"
>
  <section class="shell nyc-hero">
    <div class="nyc-copy">
      <p class="eyebrow">NYC supper club</p>
      <h1>Growth Circuit starts around one table.</h1>
      <p class="lead">
        We are starting with a focused NYC dinner series for people who build the systems, agents,
        dashboards, campaigns, and workflows behind modern growth teams.
      </p>
      <div class="hero-actions">
        <a class="button matcha" href="#apply">Apply for the waitlist</a>
        <a class="button" href="/#global">Global community next</a>
      </div>
      <div class="ritual-list" aria-label="Supper club structure">
        <div><strong>Before dinner</strong><span>A practical theme goes out</span></div>
        <div><strong>At dinner</strong><span>Members bring what they built</span></div>
        <div><strong>In the room</strong><span>We compare what worked, broke, and changed</span></div>
        <div><strong>Afterward</strong><span>The best lessons shape the wider community</span></div>
      </div>
    </div>

    <ApplicationForm client:load />
  </section>
</BaseLayout>
