---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import { listPublishedJobsIssues } from "@/lib/jobs-issues";
import { formatNewsletterIssueDate } from "@/lib/newsletter-issues";
import { breadcrumbJsonLd } from "@/lib/seo";

export const prerender = true;

const issues = await listPublishedJobsIssues();
const description =
  "A public archive of Growth Circuit’s jobs newsletter. Open roles in growth, marketing, and GTM from Lucy Hoyle.";
---

<BaseLayout
  title="Jobs"
  description={description}
  path="/jobs"
  bodyClass="sky-page pivot-page"
  jsonLd={[breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Jobs", path: "/jobs" }])]}
>
  <section class="shell listing-hero">
    <p class="eyebrow">Growth Circuit jobs</p>
    <h1>The best jobs in growth and marketing</h1>
    <p>
      A short list of open roles in growth, marketing, and go-to-market, sent by Lucy Hoyle alongside the weekly NYC
      events newsletter.
    </p>
    <p class="newsletter-issue-signup"><a href="/newsletter">NYC events newsletter →</a></p>
  </section>

  <section class="shell newsletter-archive" aria-label="Jobs issues">
    {
      issues.length ? (
        <ol class="newsletter-issue-list">
          {issues.map((issue) => (
            <li>
              <a class="newsletter-issue-card" href={issue.path}>
                <p class="eyebrow">{formatNewsletterIssueDate(issue.publishedAt)}</p>
                <h2>{issue.title}</h2>
                <p>{issue.description}</p>
                <span>Read this issue →</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <div class="directory-empty">
          <p>No issues in the archive yet. The jobs list starts in your inbox.</p>
          <a href="#newsletter">Subscribe free →</a>
        </div>
      )
    }
  </section>

  <NewsletterSignup />
</BaseLayout>
