---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ApplicationForm from "@/components/ApplicationForm";
---

<BaseLayout
  title="Apply"
  description="Apply to join Growth Circuit's first NYC cohort for Marketing Engineers."
  path="/apply"
  bodyClass="sky-page"
>
  <section class="shell apply-page">
    <div class="apply-copy">
      <a class="back-home-link" href="/">← Back to Growth Circuit</a>
      <p class="eyebrow">Apply now or join the waitlist</p>
      <h1>Find your way into the Circuit.</h1>
      <p class="lead">
        Tell us where you’re based and we’ll match you to the right cohort.
      </p>
    </div>

    <ApplicationForm client:load />
  </section>
</BaseLayout>
