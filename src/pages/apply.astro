---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ApplicationForm from "@/components/ApplicationForm";
---

<BaseLayout
  title="Apply"
  description="Apply to join Growth Circuit's first NYC cohort for Marketing Engineers."
  path="/apply"
>
  <section class="shell apply-page">
    <div class="apply-copy">
      <p class="eyebrow">First cohort application</p>
      <h1>This is a space for builders to find their people.</h1>
      <p class="lead">
        We started Growth Circuit because the best marketing engineers we know are building in
        isolation, and we think that is a waste. Applications for the first NYC cohort are open now.
      </p>
      <div class="ritual-list" aria-label="Application context">
        <div><strong>Format</strong><span>One theme per month, bring your own build</span></div>
        <div><strong>Commitment</strong><span>4 themes from Sept-Dec 2026</span></div>
        <div><strong>Selection</strong><span>Craft, range, curiosity, and energy</span></div>
      </div>
      <p class="apply-note">
        Our first cohort is focused in NYC so we can test out the format and iterate before
        scaling.
      </p>
    </div>

    <ApplicationForm client:load />
  </section>
</BaseLayout>
