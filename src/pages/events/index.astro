---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import { listHostedGrowthCircuitEvents, GROWTH_CIRCUIT_CALENDAR_URL } from "@/lib/luma-hosted-events";
import { EVENTS_DESCRIPTION } from "@/lib/page-copy";

const calendar = await listHostedGrowthCircuitEvents();
const events = calendar.status === "ok" ? calendar.events : [];
---

<BaseLayout title="Events" description={EVENTS_DESCRIPTION} path="/events" bodyClass="sky-page pivot-page">
  <section class="shell listing-hero">
    <p class="eyebrow">Growth Circuit in New York</p>
    <h1>Upcoming Growth Circuit events.</h1>
    <p>Find our next meetup, apartment gathering, or online show &amp; tell. Come by yourself or bring someone who should be in the room.</p>
  </section>
  <section class="shell calendar-section" aria-label="Upcoming Growth Circuit events">
    {events.length ? (
      <ol class="newsletter-issue-list gc-event-list">
        {events.map((event) => (
          <li>
            <a class="newsletter-issue-card" href={event.url} target="_blank" rel="noopener noreferrer">
              <p class="eyebrow"><time datetime={event.startAt}>{event.dateLabel}</time></p>
              <h2>{event.name}</h2>
              <p>{event.detail}</p>
              <span>View event and RSVP ↗</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p>{calendar.status === "ok" ? "No upcoming Growth Circuit events yet. Subscribe below and we'll email you when the next one is ready." : "The calendar isn't loading right now. You can still view it on Luma."}</p>
    )}
    <p class="luma-calendar__link">
      <a href={GROWTH_CIRCUIT_CALENDAR_URL} target="_blank" rel="noopener noreferrer">View the calendar and subscribe on Luma ↗</a>
    </p>
  </section>
  <NewsletterSignup layout="paired" />
</BaseLayout>
<style>
  .luma-calendar__link { margin-top: 16px; font-size: 0.95rem; }
  .luma-calendar__link a { text-underline-offset: 4px; }
</style>
