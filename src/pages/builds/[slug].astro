---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementHold from "@/components/AnnouncementHold.astro";
import { threads } from "@/data/forum";

export const prerender = true;

export function getStaticPaths() {
  return threads
    .filter((thread) => thread.type === "build")
    .map((thread) => ({
      params: { slug: thread.slug },
      props: { thread },
    }));
}

const { thread } = Astro.props;

if (!thread) {
  return Astro.redirect("/builds");
}
---

<BaseLayout
  title="Build Archive"
  description="Growth Circuit build pages are paused while the announcement focuses on the NYC build club."
  path={`/builds/${thread.slug}`}
  noindex
>
  <AnnouncementHold
    eyebrow="Coming later"
    title="The public build archive is hidden for launch."
    description="This page still exists in the scaffold, but we are waiting for real community demos before publishing build notes."
  />
</BaseLayout>
