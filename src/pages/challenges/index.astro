---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnnouncementHold from "@/components/AnnouncementHold.astro";
---

<BaseLayout
  title="Public Prompts Coming Later"
  description="Monthly Bring Your Own Build prompts for the Growth Circuit community."
  path="/challenges"
  noindex
>
  <AnnouncementHold
    eyebrow="Coming later"
    title="Public build prompts are paused for the announcement."
    description="For now, the prompt lives inside the NYC build club. We will turn the async challenge layer back on when the global community is ready."
  />
</BaseLayout>
