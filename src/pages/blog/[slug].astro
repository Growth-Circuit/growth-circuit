---
import BlogAuthors from "@/components/BlogAuthors.astro";
import PostMembers from "@/components/PostMembers.astro";
import ToolIcons from "@/components/ToolIcons.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  assertBlogBody,
  blogPostPath,
  extractFaq,
  formatBlogDate,
  resolveAuthors,
} from "@/lib/blog";
import { blogPostingJsonLd, breadcrumbJsonLd, faqPageJsonLd } from "@/lib/seo";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const body = post.body ?? "";
assertBlogBody(post.id, body);
const { Content } = await render(post);
const people = resolveAuthors(post.data.authors);
const path = blogPostPath(post.id);
const faq = post.data.faq === false ? [] : extractFaq(body);
const image = post.data.heroImage ?? "/growth-circuit-og-v4.png";
const jsonLd: unknown[] = [
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog" },
    { name: post.data.title, path },
  ]),
  blogPostingJsonLd({
    title: post.data.title,
    description: post.data.description,
    publishDate: post.data.publishDate,
    updatedDate: post.data.updatedDate,
    path,
    image,
    authors: people,
  }),
];
if (faq.length) jsonLd.push(faqPageJsonLd(faq));

const isShowAndTell = post.data.category === "Show & Tell";
const hasToolsOrMembers = (post.data.tools?.length ?? 0) > 0 || (post.data.members?.length ?? 0) > 0;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={path}
  bodyClass="sky-page pivot-page blog-page"
  socialType="article"
  socialImage={post.data.heroImage}
  socialImageAlt={post.data.heroImageAlt}
  feedPath="/blog/rss.xml"
  articlePublishedTime={post.data.publishDate}
  articleModifiedTime={post.data.updatedDate}
  jsonLd={jsonLd}
>
  <article>
    <header class="shell listing-hero blog-post-header">
      <div class="blog-post-meta">
        <p class="blog-post-kicker">
          <time datetime={post.data.publishDate}>{formatBlogDate(post.data.publishDate)}</time>
          {
            post.data.category && (
              <>
                <span class="blog-post-kicker-sep" aria-hidden="true">
                  /
                </span>
                <span class="blog-post-category">{post.data.category}</span>
              </>
            )
          }
        </p>
        <p class="blog-post-updated">
          Updated <time datetime={post.data.updatedDate}>{formatBlogDate(post.data.updatedDate)}</time>
        </p>
      </div>
      <h1>{post.data.title}</h1>
      <BlogAuthors authors={people} />
      {!isShowAndTell && <ToolIcons tools={post.data.tools ?? []} />}
      {!isShowAndTell && <PostMembers members={post.data.members ?? []} />}
    </header>

    {isShowAndTell && hasToolsOrMembers ? (
      <div class="shell blog-post-with-sidebar">
        <div class="blog-post-main">
          <div class="blog-post-body">
            <Content />
          </div>
        </div>
        <aside class="blog-post-sidebar" aria-label="Tools and speakers">
          {(post.data.tools?.length ?? 0) > 0 && (
            <section class="sidebar-section">
              <h2 class="sidebar-heading">Tools we talked about</h2>
              <ToolIcons tools={post.data.tools ?? []} />
            </section>
          )}
          {(post.data.members?.length ?? 0) > 0 && (
            <section class="sidebar-section">
              <h2 class="sidebar-heading">Who was there</h2>
              <PostMembers members={post.data.members ?? []} />
            </section>
          )}
        </aside>
      </div>
    ) : (
      <div class="shell blog-post-body">
        <Content />
      </div>
    )}

    <p class="shell blog-post-back"><a href="/blog">All posts →</a></p>
  </article>
</BaseLayout>

<style>
  .blog-post-with-sidebar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    padding-bottom: 48px;
  }

  @media (min-width: 1024px) {
    .blog-post-with-sidebar {
      grid-template-columns: 1fr 320px;
      gap: 64px;
    }
  }

  .blog-post-main {
    min-width: 0;
  }

  .blog-post-with-sidebar .blog-post-body {
    max-width: 100%;
    padding-bottom: 0;
  }

  .blog-post-sidebar {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 1024px) {
    .blog-post-sidebar {
      position: sticky;
      top: 24px;
      align-self: start;
    }
  }

  .sidebar-section {
    padding: 20px;
    background: #fff;
    border: 1px solid var(--pivot-line);
    border-radius: 12px;
  }

  .sidebar-heading {
    margin: 0 0 16px;
    color: var(--pivot-navy);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .sidebar-section :global(.tool-icons) {
    margin-top: 0;
  }

  .sidebar-section :global(.blog-author-list) {
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-section :global(.post-members-list) {
    margin-top: 0;
  }
</style>
