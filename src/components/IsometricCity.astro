---
const featuredEventUrl = Astro.props.featuredEventUrl as string;
---

<a
  class="city-scene"
  data-city-scene
  href={featuredEventUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="See the next Growth Circuit event"
>
  <span class="city-scene__architecture" aria-hidden="true"></span>
  <svg class="city-scene__route" viewBox="0 0 240 80" aria-hidden="true">
    <path d="M4 62C48 9 106 13 131 43C154 72 194 65 236 16" />
  </svg>
  <span class="city-scene__stage">
    <img
      src="/growth-circuit-park-slope-final.webp"
      alt="A richly illustrated row of Park Slope brownstones beside the tree-lined entrance to Prospect Park"
      width="1448"
      height="1086"
      loading="eager"
      decoding="async"
    />
  </span>
</a>

<script>
  const scenes = document.querySelectorAll<HTMLElement>("[data-city-scene]");

  for (const scene of scenes) {
    if (scene.dataset.bound === "true") continue;
    scene.dataset.bound = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let pointerX = 0;
    let pointerY = 0;
    let targetX = 0;
    let targetY = 0;
    let frame = 0;

    const render = (now: number) => {
      const time = now / 1000;
      pointerX += (targetX - pointerX) * 0.06;
      pointerY += (targetY - pointerY) * 0.06;
      scene.style.setProperty("--scene-rx", `${1.1 - pointerY * 2.1 + Math.cos(time * .34) * .28}deg`);
      scene.style.setProperty("--scene-ry", `${-1.5 + pointerX * 3 + Math.sin(time * .4) * .42}deg`);
      scene.style.setProperty("--scene-float", `${Math.sin(time * .72) * -1.5}px`);
      frame = window.requestAnimationFrame(render);
    };

    const setPointer = (event: PointerEvent) => {
      const bounds = scene.getBoundingClientRect();
      targetX = ((event.clientX - bounds.left) / bounds.width - .5) * 2;
      targetY = ((event.clientY - bounds.top) / bounds.height - .5) * 2;
    };

    const resetPointer = () => {
      targetX = 0;
      targetY = 0;
    };

    if (!reducedMotion) {
      scene.addEventListener("pointermove", setPointer, { passive: true });
      scene.addEventListener("pointerleave", resetPointer, { passive: true });
      frame = window.requestAnimationFrame(render);
    }

    document.addEventListener("astro:before-swap", () => window.cancelAnimationFrame(frame), { once: true });
  }
</script>

<style>
  .city-scene {
    --scene-rx: 1.1deg;
    --scene-ry: -1.5deg;
    --scene-float: 0px;
    position: relative;
    z-index: 1;
    display: block;
    width: min(calc(100% + 128px), 790px);
    aspect-ratio: 4 / 3;
    margin: -42px -128px -22px 0;
    isolation: isolate;
    perspective: 1300px;
    text-decoration: none;
  }

  .city-scene__architecture {
    position: absolute;
    z-index: -2;
    inset: 8% 1% 6% 12%;
    overflow: hidden;
    border: 1px solid rgba(23, 49, 58, 0.12);
    border-radius: 48% 48% 26px 26px;
    background:
      linear-gradient(rgba(23, 49, 58, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 49, 58, 0.045) 1px, transparent 1px),
      rgba(255, 255, 255, 0.34);
    background-size: 46px 46px;
    box-shadow: 0 36px 90px rgba(67, 111, 124, 0.12);
  }

  .city-scene__architecture::before,
  .city-scene__architecture::after {
    position: absolute;
    content: "";
  }

  .city-scene__architecture::before {
    inset: 24px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: inherit;
  }

  .city-scene__architecture::after {
    top: 0;
    right: 17%;
    width: 1px;
    height: 100%;
    background: rgba(23, 49, 58, 0.1);
  }

  .city-scene__route {
    position: absolute;
    z-index: -1;
    bottom: 15%;
    left: -13%;
    width: 34%;
    overflow: visible;
  }

  .city-scene__route path {
    fill: none;
    stroke: #e2765c;
    stroke-linecap: round;
    stroke-width: 3;
  }

  .city-scene__stage {
    position: absolute;
    inset: 0;
    display: block;
    transform: translate3d(0, var(--scene-float), 0) rotateX(var(--scene-rx)) rotateY(var(--scene-ry));
    transform-origin: 48% 72%;
    transform-style: preserve-3d;
    transition: transform 180ms cubic-bezier(.2, .8, .2, 1), filter 180ms ease;
    will-change: transform;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .city-scene:hover .city-scene__stage,
  .city-scene:focus-visible .city-scene__stage {
    filter: saturate(1.04) brightness(1.015);
  }

  .city-scene:focus-visible {
    outline: 3px solid #17313a;
    outline-offset: 8px;
    border-radius: 22px;
  }

  @media (prefers-reduced-motion: reduce) {
    .city-scene__stage { transition: none; }
  }

  @media (max-width: 1000px) {
    .city-scene {
      width: min(108%, 760px);
      margin: -28px auto -18px 0;
    }

    .city-scene__route {
      left: -7%;
      width: 28%;
    }
  }

  @media (max-width: 620px) {
    .city-scene {
      width: 108%;
      margin: -10px -8% -10px 0;
    }

    .city-scene__architecture {
      inset: 7% 0 5% 8%;
    }
  }
</style>
