---
import type { CommunityPostView } from "@/lib/community";
import { communityExcerpt } from "@/lib/seo";

type Props = {
  post: CommunityPostView & { headerImageUrl?: string | null };
};

const { post } = Astro.props;
const date = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
  .format(new Date(post.publishedAt || post.updatedAt));
---

<article class="community-post-card">
  <div class="community-post-card__vote" aria-label={`${post.score} upvotes`}>
    <span aria-hidden="true">▲</span><strong>{post.score}</strong>
  </div>
  <div class="community-post-card__body">
    <div class="community-module-bar">
      <span>{post.audience === "members" ? "MEMBERS" : "PUBLIC"}</span>
      <span>{date}</span>
    </div>
    {post.headerEnabled && post.headerImageUrl && <img class="community-post-card__image" src={post.headerImageUrl} alt="" loading="lazy" />}
    <div class="community-post-card__content">
      <p class="community-post-card__byline">Posted by <strong>{post.authorName}</strong></p>
      <h2><a href={`/community/${post.slug}`}>{post.title}</a></h2>
      <p>{communityExcerpt(post.bodyMarkdown, 220)}</p>
      <div class="community-post-card__meta">
        <a href={`/community/${post.slug}#replies`}>{post.replyCount} {post.replyCount === 1 ? "reply" : "replies"}</a>
        <span>{post.score} {post.score === 1 ? "upvote" : "upvotes"}</span>
        {post.githubRepositoryUrl && <span>GitHub linked</span>}
      </div>
    </div>
  </div>
</article>
