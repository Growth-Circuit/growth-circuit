---
import type { Author } from "@/data/authors";

type Props = { authors: Author[] };

const { authors } = Astro.props;
---

<ul class="blog-author-list">
  {
    authors.map((author) => (
      <li class="blog-author">
        <img
          class="blog-author-photo"
          src={author.photo}
          alt={author.name}
          width="48"
          height="48"
          style={author.photoPosition ? `object-position: ${author.photoPosition}` : undefined}
        />
        <div class="blog-author-copy">
          <p class="blog-author-name-line">
            {author.website ? (
              <a class="blog-author-name" href={author.website} target="_blank" rel="noopener noreferrer">
                {author.name}
              </a>
            ) : (
              <span class="blog-author-name">{author.name}</span>
            )}
            {author.linkedin && (
              <a
                class="blog-author-linkedin"
                href={author.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${author.name} on LinkedIn`}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V24h-4V8.5zM8.5 8.5h3.8v2.1h.05c.53-1 1.84-2.1 3.79-2.1 4.05 0 4.8 2.67 4.8 6.14V24h-4v-7.7c0-1.84-.03-4.2-2.56-4.2-2.56 0-2.95 2-2.95 4.06V24h-4V8.5z"
                  />
                </svg>
              </a>
            )}
          </p>
          <p class="blog-author-role">{author.role}</p>
        </div>
      </li>
    ))
  }
</ul>
