---
import { FALLBACK_OG_IMAGE, OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH, ogImageAlt, ogImagePath } from "@/lib/og";
import { getOgCard } from "@/lib/og-cards";
import { canonical, organizationJsonLd, serializeJsonLd } from "@/lib/seo";

export interface Props {
  title?: string;
  appendSiteName?: boolean;
  description?: string;
  path?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
  socialImage?: string;
  socialImageAlt?: string;
  socialType?: "website" | "article";
  feedPath?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  title = "Growth Circuit",
  appendSiteName = true,
  description = "An NYC-first community for people building growth systems.",
  path = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
  socialImage,
  socialImageAlt: suppliedSocialImageAlt,
  socialType = "website",
  feedPath,
  articlePublishedTime,
  articleModifiedTime,
} = Astro.props;

const fullTitle = !appendSiteName || title === "Growth Circuit" ? title : `${title} | Growth Circuit`;
const canonicalUrl = canonical(path);
const ogCard = socialImage || noindex ? undefined : await getOgCard(path);
const image = ogCard
  ? { url: canonical(ogImagePath(ogCard.path)), width: OG_IMAGE_WIDTH, height: OG_IMAGE_HEIGHT, alt: ogImageAlt(ogCard) }
  : socialImage
    ? { url: canonical(socialImage), width: OG_IMAGE_WIDTH, height: OG_IMAGE_HEIGHT, alt: suppliedSocialImageAlt || FALLBACK_OG_IMAGE.alt }
    : { url: canonical(FALLBACK_OG_IMAGE.path), width: FALLBACK_OG_IMAGE.width, height: FALLBACK_OG_IMAGE.height, alt: FALLBACK_OG_IMAGE.alt };
const allJsonLd = [organizationJsonLd(), ...jsonLd];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#dceef5" />
<link rel="icon" href="/growth-circuit-icon.svg" type="image/svg+xml" />
<link rel="icon" href="/growth-circuit-favicon-256.png" type="image/png" sizes="256x256" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{feedPath && <link rel="alternate" type="application/rss+xml" title="Growth Circuit Blog" href={canonical(feedPath)} />}
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:type" content={socialType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Growth Circuit" />
<meta property="og:image" content={image.url} />
<meta property="og:image:secure_url" content={image.url} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={image.alt} />
{articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
{articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.url} />
<meta name="twitter:image:alt" content={image.alt} />
{allJsonLd.map((entry) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(entry)} />)}
