---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import LumaCalendar from "@/components/LumaCalendar.astro";

interface Props { preview?: boolean; }
const { preview = false } = Astro.props;
---

<BaseLayout noindex={preview} title={preview ? "Homepage preview" : "Growth Circuit | A Global Community Of Marketing Engineers"} appendSiteName={preview} description="Find the best NYC events for marketers, delivered to your inbox. Join Nick and Lucy for in-person gatherings, online demos, and a community that gets what you do." hideHeader bodyClass="sky-page circuit-home">
  <a class="gc-skip" href="#main-content">Skip to content</a>
  <SiteHeader />

  <section class="gc-hero" id="main-content" aria-labelledby="hero-title">
    <div class="shell gc-hero-grid">
      <div class="gc-hero-copy">
        <h1 id="hero-title">Find the best NYC events for marketers</h1>
        <p class="gc-lead">A short, highly curated weekly email of the best NYC and virtual events for marketers in growth and AI, sourced by Nick Lafferty from Profound and Lucy Hoyle from Carta. We also host our own events :)</p>
        <NewsletterSignup formOnly />
      </div>
      <figure class="gc-neighborhood">
        <div class="gc-neighborhood-caption"><span class="gc-dot" aria-hidden="true"></span> A little closer to your kind of people.</div>
        <img src="/growth-circuit-park-slope-final.webp" alt="An illustrated neighborhood of Park Slope brownstones beside Prospect Park in Brooklyn" width="1448" height="1086" fetchpriority="high" />
        <figcaption><span>Starting in New York</span><span>See you around the neighborhood.</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="gc-in-person" id="events" aria-labelledby="events-title"><div class="shell gc-events-inner"><div class="gc-events-intro"><h2 id="events-title">Make room for a hello.</h2><p>Find our next NYC gathering or online show &amp; tell. Come solo, bring a friend, and meet the people behind the work.</p></div><p class="gc-events-archive"><a class="gc-link" href="/newsletter">Read the latest newsletter</a></p><LumaCalendar loading="eager" /></div></section>

  <section class="shell gc-community" id="how-it-works" aria-labelledby="community-title">
    <div class="gc-section-heading"><h2 id="community-title">Growth is better<br />in good company</h2><p>Come for an event. Meet someone who gets excited about the same things you do. Keep the conversation going between meetups.</p></div>
    <div class="gc-routes">
      <article><div class="gc-route-symbol gc-route-meet" aria-hidden="true"><span></span><span></span><span></span></div><h3>Meet your people.</h3><p>Come to a public NYC event. Talk about what you’re working on. Leave with someone you want to keep in touch with.</p></article>
      <article><div class="gc-route-symbol gc-route-chat" aria-hidden="true"><span></span><span></span></div><h3>Get another perspective.</h3><p>A question about your stack. An experiment that surprised you. WhatsApp is where the conversation carries on between events.</p></article>
      <article><div class="gc-route-symbol gc-route-build" aria-hidden="true"><span>↗</span></div><h3>Bring what you’re building.</h3><p>Share the workflow, tool, or scrappy first version you’ve been working on. Find people who understand the problem and can compare notes.</p></article>
    </div>
    <div class="gc-community-next" id="join"><a class="gc-link" href="/apply?path=nyc">Join the Growth Circuit WhatsApp Community</a><p>Subscribe to get the latest event list. A few days later, we’ll send an invitation to join the conversation on WhatsApp.</p><p class="gc-privacy">WhatsApp is optional. Other members of the group can see your phone number. We review community applications before sharing an invite.</p></div>
  </section>

  <section class="gc-hosts" aria-label="Meet your hosts"><div class="shell gc-hosts-inner">
    <div class="gc-host-intro"><h2>Built by people<br />doing the work.</h2><p>We’re Nick and Lucy. We started Growth Circuit to meet more people building things in marketing, growth, and AI. Come say hello.</p></div>
    <figure class="gc-host"><img class="gc-host-photo gc-host-photo-nick" src="/hosts/nick-lafferty.jpg" alt="Nick Lafferty speaking about marketing engineering" width="800" height="921" loading="lazy" /><figcaption><a href="https://www.linkedin.com/in/nicklafferty/" target="_blank" rel="noopener noreferrer">Nick Lafferty</a><span>Profound</span></figcaption></figure>
    <figure class="gc-host"><img class="gc-host-photo gc-host-photo-lucy" src="/hosts/lucy-hoyle-blurred.jpg" alt="Lucy Hoyle speaking at an event" width="1086" height="1448" loading="lazy" /><figcaption><a href="https://www.linkedin.com/in/lucyjanehoyle" target="_blank" rel="noopener noreferrer">Lucy Hoyle</a><span>Carta</span></figcaption></figure>
  </div></section>

  <section class="shell gc-faq" aria-labelledby="faq-title"><h2 id="faq-title">A few things<br />you might be wondering.</h2><div><details><summary>Is this for marketers or engineers?</summary><p>Both, and anyone building growth systems. Your job title matters less than your interest in the work and willingness to share what you’re learning.</p></details><details><summary>Do I have to live in New York?</summary><p>No. The newsletter includes NYC and virtual events, so you can find something to join from wherever you are. Our in-person gatherings are in New York.</p></details><details><summary>Can I come to an event on my own?</summary><p>Yes! Public events are a way to meet people. Browse the events above for details and RSVP requirements, and come by yourself or bring a friend.</p></details><details><summary>What happens after I subscribe?</summary><p>Confirm your email and we’ll send you the most recent list of events. A few days later, you’ll get an invitation to join us on WhatsApp. You can keep reading the newsletter whether or not you join the group.</p></details></div></section>
</BaseLayout>

<style>
  :global(.circuit-home) { --gc-ink:#17313a; --gc-muted:#4d6570; --gc-blue:#dceef5; --gc-green:#d6e5d2; --gc-accent:#355e49; color-scheme:light; background:#f7fcfd; }
  :global(.circuit-home .footer) { background:#e8f1ed; color:#425c62; border-color:#cbded7; }
  :global(.circuit-home .footer a) {color:#17313a;}
  .gc-skip { position:absolute; top:-80px; left:16px; z-index:100; padding:12px 20px; background:white; color:#17313a; } .gc-skip:focus{top:12px;}

  .gc-button {display:inline-flex;justify-content:center;align-items:center;min-height:52px;padding:14px 25px;border-radius:8px;background:var(--gc-ink);color:#fff;font-size:15px;font-weight:700;text-align:center;line-height:1.3;transition:background .15s;} .gc-button:hover{background:#355e49;} .gc-button-small{min-height:42px;padding:11px 18px;} .gc-link{font-size:15px;font-weight:700;text-decoration:underline;text-underline-offset:5px;text-decoration-color:#90aaa9;} .gc-link:hover{text-decoration-color:currentColor;} a:focus-visible,summary:focus-visible{outline:3px solid #287f91;outline-offset:5px;}
  .gc-hero{background:var(--gc-blue);overflow:hidden;} .gc-hero-grid{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:10px;min-height:625px;padding-top:45px;padding-bottom:68px;}
  .gc-dot{width:8px;height:8px;background:#355e49;border-radius:50%;flex-shrink:0;}
  .gc-hero-copy{position:relative;z-index:1;}
  h1{font-size:clamp(44px,4.7vw,65px);line-height:1.06;letter-spacing:-.055em;margin:25px 0;max-width:650px;font-weight:760;} .gc-lead{font-size:18px;line-height:1.65;max-width:540px;margin:0 0 26px;}
  .gc-neighborhood{margin:0 -65px 0 0;position:relative;} .gc-neighborhood img{width:100%;height:auto;mix-blend-mode:multiply;} .gc-neighborhood-caption{display:flex;align-items:center;justify-content:center;gap:9px;font-size:12px;color:#3c5c62;} .gc-neighborhood figcaption{display:flex;justify-content:space-between;margin:0 65px 0 45px;padding-top:16px;border-top:1px solid #aecbd2;font-size:11px;color:#45616b;}
  .gc-hosts{background:#e9f3f6;border-bottom:1px solid #d4e5eb;} .gc-hosts-inner{display:flex;align-items:center;justify-content:center;gap:42px;padding:25px 0;} .gc-hosts p{margin:0;font-size:14px;font-weight:650;} .gc-hosts p:first-child{color:var(--gc-muted);font-weight:500;margin-right:18px;} .gc-hosts p span{display:block;font-size:12px;color:var(--gc-muted);font-weight:400;margin-top:2px;}  .gc-hosts a:hover{text-decoration:underline;}
  h2{font-size:clamp(32px,3.2vw,44px);line-height:1.15;letter-spacing:-.04em;margin:0;font-weight:740;} h3{letter-spacing:-.025em;} .gc-community{padding-top:94px;padding-bottom:90px;scroll-margin-top:25px;} .gc-section-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:90px;align-items:center;} .gc-section-heading>p{color:var(--gc-muted);line-height:1.8;font-size:16px;margin:0;max-width:425px;}
  .gc-routes{display:grid;grid-template-columns:repeat(3,1fr);gap:55px;margin-top:54px;} .gc-routes article{display:flex;flex-direction:column;align-items:flex-start;} .gc-routes h3{font-size:23px;margin:23px 0 12px;} .gc-routes p{font-size:15px;line-height:1.8;margin:0 0 21px;color:var(--gc-muted);} .gc-routes a{margin-top:auto;font-size:14px;}
  .gc-route-symbol{height:57px;display:flex;align-items:center;position:relative;} .gc-route-meet span{width:40px;height:40px;background:#cedfc7;border:2px solid #f7fcfd;border-radius:50%;margin-left:-9px;} .gc-route-meet span:first-child{margin:0;background:#84a293;} .gc-route-meet span:last-child{background:#aed2de;} .gc-route-chat span{width:42px;height:32px;border:2px solid #62849a;border-radius:12px 12px 12px 2px;background:#e1eef5;} .gc-route-chat span:last-child{position:relative;top:12px;left:-12px;background:#c5dfc1;border-color:#6d8c69;transform:scaleX(-1);} .gc-route-build span{height:48px;width:48px;background:#d4e4d0;border-radius:12px;display:grid;place-items:center;font-size:32px;color:#426046;}
  .gc-in-person{background:#e8f0e5;padding:66px 0;}
  .gc-faq{display:grid;grid-template-columns:1fr 1.25fr;gap:65px;border-top:1px solid #d5e2e6;padding-top:65px;padding-bottom:90px;} .gc-faq h2{font-size:32px;} details{border-bottom:1px solid #d5e2e6;} summary{cursor:pointer;font-size:16px;font-weight:650;padding:19px 28px 19px 0;position:relative;list-style:none;} summary::-webkit-details-marker{display:none;} summary:after{content:'+';position:absolute;right:3px;font-size:21px;top:15px;font-weight:400;} details[open] summary:after{content:'−';} details p{font-size:15px;line-height:1.8;color:var(--gc-muted);margin:0;padding:0 25px 23px 0;}
  @media(min-width:1400px){.gc-hero-grid{min-height:670px;}} @media(max-width:1000px){.gc-hero-grid{grid-template-columns:1.2fr 1fr;}.gc-neighborhood{margin:0 -35px 0 0;}.gc-neighborhood figcaption{margin:0 30px;gap:20px;}.gc-section-heading{gap:40px;}.gc-routes{gap:28px;}}
  @media(max-width:700px){.gc-button-small{min-height:38px;padding:10px 12px;}.gc-hero-grid{grid-template-columns:1fr;gap:30px;padding-top:32px;padding-bottom:25px;min-height:auto;}h1{font-size:clamp(42px,8vw,58px);max-width:560px;margin:24px 0;}.gc-lead{font-size:17px;max-width:500px;}.gc-neighborhood{margin:0 auto;width:100%;max-width:530px;}.gc-neighborhood-caption{display:none;}.gc-neighborhood figcaption{margin:0 10px;font-size:10px;}.gc-hosts-inner{flex-wrap:wrap;gap:18px 30px;padding:23px 0;}.gc-hosts p:first-child{width:100%;text-align:center;margin:0 0 3px;font-size:13px;}.gc-hosts p{font-size:13px;}.gc-community{padding-top:57px;padding-bottom:55px;}.gc-section-heading{grid-template-columns:1fr;gap:20px;}.gc-section-heading>p{max-width:none;font-size:15px;}.gc-routes{grid-template-columns:1fr;gap:31px;margin-top:33px;}.gc-routes article{position:relative;padding-left:78px;}.gc-route-symbol{position:absolute;top:0;left:0;transform:scale(.75);transform-origin:left top;}.gc-routes h3{margin:4px 0 10px;font-size:22px;}.gc-routes p{margin-bottom:13px;}.gc-in-person{padding:45px 0;}.gc-privacy{text-align:left;}.gc-faq{grid-template-columns:1fr;gap:20px;padding-top:42px;padding-bottom:55px;}.gc-faq h2{font-size:30px;}summary{font-size:15px;}}

  @media(max-width:370px){.gc-button{padding:14px 18px;}h1{font-size:40px;}}

  .gc-hero-copy :global(.newsletter-section){scroll-margin-top:24px;}
  .gc-hero-copy :global(.newsletter-fields button){background:var(--gc-ink);color:white;border-radius:8px;font-size:14px;}
  .gc-hero-copy :global(.newsletter-fields input){font-size:16px;}
  .gc-hero-copy :global(.newsletter-consent){color:var(--gc-muted);font-size:12px;}
  .gc-community-next{margin-top:24px;max-width:650px;scroll-margin-top:24px;}
  .gc-community-next>p{font-size:15px;line-height:1.75;color:var(--gc-muted);}
  .gc-community-next .gc-privacy{font-size:12px;}
  .gc-events-archive{margin:0 0 28px;}
  .gc-hosts-inner{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;padding:48px 0;align-items:center;}
  .gc-host-intro h2{font-size:34px;}
  .gc-host-intro p{color:var(--gc-muted);font-size:15px;line-height:1.75;max-width:320px;margin:18px 0 0;font-weight:400;}
  .gc-host{margin:0;min-width:0;}
  .gc-host-photo{width:100%;height:230px;object-fit:cover;border-radius:12px;}
  .gc-host-photo-nick{object-position:30% 25%;}
  .gc-host-photo-lucy{object-position:50% 8%;}
  .gc-host figcaption{margin-top:14px;font-size:16px;font-weight:700;}
  .gc-host figcaption span{display:block;font-size:13px;font-weight:400;color:var(--gc-muted);margin-top:4px;}
  #events{scroll-margin-top:25px;}
  .gc-events-intro{display:flex;justify-content:space-between;align-items:center;gap:45px;margin-bottom:30px;}
  .gc-events-intro p{max-width:450px;font-size:16px;line-height:1.75;color:#4d6354;}
  @media(max-width:700px){.gc-hosts-inner{grid-template-columns:1fr 1fr;gap:25px 18px;padding:35px 0;}.gc-host-intro{grid-column:1 / -1;}.gc-host-intro h2{font-size:30px;}.gc-host-intro p{max-width:100%;}.gc-host-photo{height:200px;}.gc-host figcaption{font-size:15px;}.gc-events-intro{display:block;}.gc-events-intro p{font-size:15px;}}
</style>
