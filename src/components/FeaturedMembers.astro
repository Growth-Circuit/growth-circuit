---
import { featuredMembers } from "@/data/featured-community";
interface Props { directory?: boolean; }
const { directory = false } = Astro.props;
---
<section class="shell featured-members" id="members" aria-labelledby="members-title">
  <div class="members-heading">
    <div><h2 id="members-title">A few people in your circuit.</h2><p>Meet some of the people you’ll find at our events and in the community.</p></div>
    {!directory && <a class="directory-link" href="/people">Meet the community <span aria-hidden="true">↗</span></a>}
  </div>
  <ul class="member-grid" role="list">
    {featuredMembers.map((member) => <li>
      <article class="member-profile">
        <div class="member-identity">
          {member.photo ? <img class="member-avatar" src={member.photo} alt="" width="72" height="72" loading="lazy" /> : <span class="member-avatar member-initials" aria-hidden="true">{member.initials}</span>}
          <div>
            <div class="member-name">
              <h3><a href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.name}, LinkedIn profile (opens in a new tab)`}>{member.name}</a></h3>
              {"cofounder" in member && member.cofounder && <span class="founder-badge" tabindex="0" aria-label="Growth Circuit co-founder" aria-describedby={`founder-${member.initials}`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.8 1-6.1L3.2 9.4l6.1-.9L12 3Z" /></svg>
                <span class="founder-tooltip" role="tooltip" id={`founder-${member.initials}`}>Growth Circuit co-founder</span>
              </span>}
            </div>
            <p class="member-company">{member.company}</p>
          </div>
        </div>
        <p class="member-detail">{member.detail}</p>
      </article>
    </li>)}
  </ul>
</section>
<style>
  .featured-members{padding-top:64px;padding-bottom:68px;color:#17313a;scroll-margin-top:25px;}
  .members-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:32px;}
  h2{font-size:clamp(28px,3vw,38px);line-height:1.2;letter-spacing:-.04em;margin:0;font-weight:740;}
  .members-heading p{color:#4d6570;font-size:15px;line-height:1.75;margin:14px 0 0;max-width:500px;}
  .directory-link{font-size:14px;font-weight:650;white-space:nowrap;text-decoration:underline;text-underline-offset:5px;}
  .member-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:0;margin:0;list-style:none;gap:0 32px;}
  .member-profile{display:block;padding:25px 0;border-top:1px solid #cbdde2;height:100%;text-decoration:none;}
  .member-identity{display:flex;gap:15px;align-items:center;}
  .member-avatar{width:64px;height:64px;flex-shrink:0;border-radius:50%;object-fit:cover;object-position:center 20%;}
  .member-initials{display:grid;place-items:center;background:#dceef5;color:#355e49;font-size:22px;font-weight:600;}
  li:nth-child(even) .member-initials{background:#d6e5d2;}
  h3{font-size:18px;line-height:1.3;letter-spacing:-.025em;margin:0;font-weight:700;}
  .member-company{color:#355e49;font-size:14px;margin:5px 0 0;font-weight:600;}
  .member-detail{font-size:14px;line-height:1.6;color:#4d6570;margin:16px 0 12px;}
  .member-name{display:flex;align-items:center;gap:8px;}
  h3 a{text-decoration:underline;text-underline-offset:4px;text-decoration-color:#9cb6bd;}
  h3 a:hover{color:#355e49;text-decoration-color:currentColor;}
  .founder-badge{position:relative;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:24px;height:24px;border-radius:50%;background:#d6e5d2;color:#355e49;cursor:help;}
  .founder-tooltip{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);padding:7px 10px;border-radius:5px;background:#17313a;color:#fff;font-size:12px;font-weight:500;line-height:1.4;white-space:nowrap;opacity:0;visibility:hidden;pointer-events:none;z-index:2;}
  .founder-badge:hover .founder-tooltip,.founder-badge:focus .founder-tooltip{opacity:1;visibility:visible;}
  .founder-badge:focus-visible{outline:3px solid #287f91;outline-offset:3px;}
  a:focus-visible{outline:3px solid #287f91;outline-offset:5px;}
  @media(max-width:850px){.member-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
  @media(max-width:700px){.featured-members{padding-top:42px;padding-bottom:42px;}.members-heading{display:block;}.directory-link{display:inline-block;margin-top:17px;}h2{font-size:29px;}.member-grid{gap:0 22px;}.member-identity{display:block;}.member-avatar{margin-bottom:12px;width:56px;height:56px;}h3{font-size:17px;}}
  @media(max-width:370px){.member-grid{grid-template-columns:1fr;}.member-identity{display:flex;}.member-avatar{margin-bottom:0;}}
</style>
