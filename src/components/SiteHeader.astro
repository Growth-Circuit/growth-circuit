---
const homeAnchor = (id: string) => `${Astro.url.pathname === "/" ? "" : "/"}#${id}`;
---
<header class="gc-header">
  <div class="shell gc-nav">
    <a class="brand" href="/" aria-label="Growth Circuit home"><img class="brand-logo" src="/growth-circuit-icon.svg" alt="" width="44" height="44" /><span>Growth Circuit</span></a>
    <nav aria-label="Main navigation">
      <a class="gc-nav-about" href={homeAnchor("how-it-works")}>The community</a>
      <a href="/newsletter">Newsletter</a>
      <a href="/blog">Blog</a>
      <a href={homeAnchor("events")}>Events</a>
      <a class="gc-subscribe" href={homeAnchor("newsletter")}>Subscribe free</a>
    </nav>
  </div>
</header>
<style>
  .gc-header{background:#dceef5;color:#17313a;color-scheme:light;}
  .gc-nav{display:flex;align-items:center;justify-content:space-between;min-height:100px;gap:24px;}
  .gc-nav nav{display:flex;align-items:center;gap:30px;}
  .gc-nav nav>a{font-size:14px;font-weight:650;color:#17313a;}
  .gc-nav .brand{font-size:19px;color:#17313a;font-family:ui-rounded,"SF Pro Rounded","Arial Rounded MT Bold","Avenir Next",sans-serif;}
  .brand-logo{box-shadow:0 6px 20px rgba(23,49,58,.16);border-radius:50%;}
  .gc-nav nav>.gc-subscribe{display:inline-flex;justify-content:center;align-items:center;min-height:42px;padding:11px 18px;border-radius:8px;background:#17313a;color:#fff;font-size:15px;font-weight:700;text-align:center;line-height:1.3;transition:background .15s;}
  .gc-nav nav>.gc-subscribe:hover{background:#355e49;}
  a:focus-visible{outline:3px solid #287f91;outline-offset:5px;}
  @media(max-width:1000px){.gc-nav nav{gap:18px;}}
  @media(max-width:700px){.gc-nav{min-height:82px;gap:12px;}.gc-nav .brand{font-size:15px;gap:8px;}.brand-logo{width:34px;height:34px;flex-basis:34px;}.gc-nav nav{gap:15px;}.gc-nav nav>a{font-size:12px;}.gc-nav-about{display:none;}.gc-nav nav>.gc-subscribe{min-height:38px;padding:10px 12px;font-size:12px;}}
  @media(max-width:430px){.brand span{display:none;}.gc-nav{gap:8px;}.gc-nav nav{gap:10px;}.gc-nav nav>a{white-space:nowrap;}.gc-nav nav>.gc-subscribe{padding-inline:10px;}}
  @media(max-width:370px){.gc-nav{gap:8px;}.gc-nav nav{gap:10px;}.gc-nav nav>.gc-subscribe{padding-inline:10px;}}
</style>
