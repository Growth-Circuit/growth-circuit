---
const homeAnchor = (id: string) => `${Astro.url.pathname === "/" ? "" : "/"}#${id}`;
---
<header class="gc-header">
  <div class="shell gc-nav">
    <a class="brand" href="/" aria-label="Growth Circuit home"><img class="brand-logo" src="/growth-circuit-icon.svg" alt="" width="44" height="44" /><span>Growth Circuit</span></a>
    <nav aria-label="Main navigation">
      <div id="gc-nav-menu" class="gc-nav-menu">
        <a class="gc-nav-about" href={homeAnchor("how-it-works")}>The community</a>
        <a href="/newsletter">Newsletter</a>
        <a href="/blog">Blog</a>
        <a href={homeAnchor("events")}>Events</a>
      </div>
      <a class="gc-subscribe" href={homeAnchor("newsletter")}>Subscribe free</a>
      <button class="gc-menu-button" type="button" aria-expanded="false" aria-controls="gc-nav-menu" aria-label="Open menu">
        <span class="gc-menu-bars" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
  <div class="gc-nav-scrim" hidden></div>
</header>
<script>
  const header = document.querySelector(".gc-header");
  const button = header?.querySelector(".gc-menu-button");
  const menu = header?.querySelector(".gc-nav-menu");
  const scrim = header?.querySelector(".gc-nav-scrim");
  if (header && button instanceof HTMLButtonElement && menu instanceof HTMLElement && scrim instanceof HTMLElement) {
    const desktop = window.matchMedia("(min-width: 761px)");
    const setOpen = (open: boolean) => {
      menu.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", open ? "true" : "false");
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (open) scrim.removeAttribute("hidden");
      else scrim.setAttribute("hidden", "");
    };
    button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
    header.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest(".gc-nav a")) setOpen(false);
    });
    scrim.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || button.getAttribute("aria-expanded") !== "true") return;
      setOpen(false);
      button.focus();
    });
    desktop.addEventListener("change", () => {
      if (desktop.matches) setOpen(false);
    });
  }
</script>
<style>
  .gc-header{position:relative;z-index:30;background:#dceef5;color:#17313a;color-scheme:light;}
  .gc-nav{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;min-height:100px;gap:24px;}
  .gc-nav nav{display:flex;align-items:center;gap:30px;}
  .gc-nav-menu{display:contents;}
  .gc-nav nav a{font-size:14px;font-weight:650;color:#17313a;}
  .gc-nav .brand{font-size:19px;color:#17313a;font-family:ui-rounded,"SF Pro Rounded","Arial Rounded MT Bold","Avenir Next",sans-serif;}
  .brand-logo{box-shadow:0 6px 20px rgba(23,49,58,.16);border-radius:50%;}
  .gc-nav nav>.gc-subscribe{display:inline-flex;justify-content:center;align-items:center;min-height:42px;padding:11px 18px;border-radius:8px;background:#17313a;color:#fff;font-size:15px;font-weight:700;text-align:center;line-height:1.3;transition:background .15s;}
  .gc-nav nav>.gc-subscribe:hover{background:#355e49;}
  .gc-menu-button{display:none;}
  .gc-nav-scrim[hidden]{display:none;}
  a:focus-visible,.gc-menu-button:focus-visible{outline:3px solid #287f91;outline-offset:5px;}
  @media(max-width:1000px){.gc-nav nav{gap:18px;}}
  @media(max-width:760px){
    .gc-nav{min-height:82px;gap:12px;}
    .gc-nav .brand{font-size:15px;gap:8px;}
    .gc-nav .brand span{white-space:nowrap;}
    .brand-logo{width:34px;height:34px;flex:0 0 34px;}
    .gc-nav nav{gap:8px;}
    .gc-menu-button{display:inline-flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;height:44px;padding:0;border:0;border-radius:8px;background:transparent;color:#17313a;cursor:pointer;}
    .gc-menu-button:hover{background:rgba(23,49,58,.08);}
    .gc-menu-bars,.gc-menu-bars::before,.gc-menu-bars::after{display:block;width:18px;height:2px;border-radius:1px;background:currentColor;position:relative;}
    .gc-menu-bars::before,.gc-menu-bars::after{content:"";position:absolute;left:0;}
    .gc-menu-bars::before{top:-6px;}
    .gc-menu-bars::after{top:6px;}
    .gc-menu-button[aria-expanded="true"] .gc-menu-bars{background:transparent;}
    .gc-menu-button[aria-expanded="true"] .gc-menu-bars::before{top:0;transform:rotate(45deg);}
    .gc-menu-button[aria-expanded="true"] .gc-menu-bars::after{top:0;transform:rotate(-45deg);}
    .gc-nav-menu{display:none;position:absolute;z-index:3;top:calc(100% + 8px);left:0;right:0;flex-direction:column;align-items:stretch;gap:4px;padding:8px;border-radius:8px;background:#fff;box-shadow:0 16px 40px rgba(23,49,58,.16);}
    .gc-nav-menu.is-open{display:flex;}
    .gc-nav .gc-nav-menu a{display:flex;align-items:center;min-height:44px;padding:0 12px;border-radius:8px;font-size:16px;white-space:nowrap;}
    .gc-nav .gc-nav-menu a:hover{background:rgba(23,49,58,.06);}
    .gc-nav nav>.gc-subscribe{flex:0 0 auto;min-height:44px;padding:10px 14px;font-size:14px;white-space:nowrap;}
    .gc-nav-scrim:not([hidden]){position:fixed;inset:0;z-index:1;background:rgba(23,49,58,.18);}
  }
  @media(max-width:360px){.brand span{display:none;}}
</style>
