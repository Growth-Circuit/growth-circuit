---
import { jobsCopy } from "@/lib/newsletter-copy";
interface Props { variant?: "events" | "jobs"; id?: string; showArchiveLink?: boolean; formOnly?: boolean; adaptive?: boolean; }
const { id = "newsletter", showArchiveLink = false, formOnly = false, adaptive = false, variant = "events" } = Astro.props;

const eventsCopy = {
  eyebrow: "A few good reasons to leave the apartment",
  headline: "Find the best NYC events for marketers",
  body: "Public talks, demos, meetups, and Growth Circuit gatherings. A short list from Nick and Lucy for people building things in marketing, growth, and AI.",
  button: "Email me the events",
  note: "Get the latest event list when you subscribe. A few days later, we’ll invite you to join the conversation on WhatsApp. WhatsApp is optional.",
};
const allCopy = {
  eyebrow: "The best of growth and marketing",
  headline: "Stay in the circuit",
  body: "Events worth showing up to and jobs worth applying for, delivered to your inbox.",
  button: "Email me the newsletter",
  note: "Get the latest event and job news when you subscribe. A few days later, we’ll invite you to join the conversation on WhatsApp. WhatsApp is optional.",
};
const copy = adaptive ? allCopy : variant === "jobs" ? jobsCopy : eventsCopy;
const consent = adaptive || variant === "jobs"
  ? "I’d like to receive emails from Growth Circuit"
  : "I’d like Growth Circuit’s NYC event emails. I can unsubscribe anytime.";
---
<section class:list={["newsletter-section", { shell: !formOnly, "newsletter-inline": formOnly }]} id={id} aria-labelledby={formOnly ? undefined : `${id}-title`} aria-label={formOnly ? "Newsletter signup" : undefined}>
  {!formOnly && <div class:list={[{ "newsletter-signup-copy": adaptive || variant === "jobs" }]}>
    <p class="eyebrow" data-copy-all={adaptive ? allCopy.eyebrow : undefined} data-copy-events={adaptive ? eventsCopy.eyebrow : undefined} data-copy-jobs={adaptive ? jobsCopy.eyebrow : undefined}>{copy.eyebrow}</p>
    <h2 id={`${id}-title`} data-copy-all={adaptive ? allCopy.headline : undefined} data-copy-events={adaptive ? eventsCopy.headline : undefined} data-copy-jobs={adaptive ? jobsCopy.headline : undefined}>{copy.headline}</h2>
    <p data-copy-all={adaptive ? allCopy.body : undefined} data-copy-events={adaptive ? eventsCopy.body : undefined} data-copy-jobs={adaptive ? jobsCopy.body : undefined}>{copy.body}</p>
    {showArchiveLink && <p><a class="newsletter-archive-link" href="/newsletter">Read past newsletters →</a></p>}
  </div>}
  <form method="post" action="/api/newsletter" class="newsletter-form" aria-label={variant === "jobs" ? "Subscribe to the jobs newsletter" : "Subscribe to the NYC newsletter"}>
    <label for={`${id}-email`}>Email address</label>
    <div class="signup-row">
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="254" placeholder={formOnly ? "your email address" : "you@example.com"} required />
      <button class="button matcha" type="submit" data-copy-all={adaptive ? allCopy.button : undefined} data-copy-events={adaptive ? eventsCopy.button : undefined} data-copy-jobs={adaptive ? jobsCopy.button : undefined}>{copy.button}</button>
    </div>
    <label class="newsletter-consent"><input name="consent" type="checkbox" checked required /> <span>{consent}</span></label>
    <div class="newsletter-trap" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <p class="newsletter-status" role="status" aria-live="polite"></p>
    <noscript>Please enable JavaScript to use this signup form.</noscript>
    {!formOnly && <p class="newsletter-note" data-copy-all={adaptive ? allCopy.note : undefined} data-copy-events={adaptive ? allCopy.note : undefined} data-copy-jobs={adaptive ? allCopy.note : undefined}>{copy.note}</p>}
  </form>
</section>
<script>
  document.querySelectorAll<HTMLFormElement>(".newsletter-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const status = form.querySelector<HTMLElement>(".newsletter-status")!;
      const fields = new FormData(form);
      button.disabled = true; status.textContent = "Sending your confirmation email…";
      try {
        const response = await fetch("/api/newsletter", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: fields.get("email"), consent: fields.get("consent") === "on", website: fields.get("website") }) });
        const result = await response.json().catch(() => ({ error: "This is temporarily unavailable. Please try again shortly." })) as { error?: string };
        if (!response.ok) throw new Error(result.error || "Signup is temporarily unavailable. Please try again shortly.");
        status.textContent = "Check your inbox to confirm. If you already requested a link, use that email. The link is valid for 24 hours.";
        form.reset();
      } catch (error) { status.textContent = error instanceof Error ? error.message : "Please try again shortly."; }
      finally { button.disabled = false; }
    });
  });
</script>
<style>
  /* Content blockers' annoyance lists hide `.newsletter-fields`, so the input row keeps a neutral class name. */
  .newsletter-section { display:grid; grid-template-columns:1.1fr 1fr; gap:3rem; padding-top:4rem; padding-bottom:4rem; border-top:1px solid #b9c8c2; }
  .newsletter-section.newsletter-inline { display:block; padding:0; border:0; }
  .newsletter-section h2 { font-size:clamp(2rem,4vw,3rem); line-height:1.1; margin:.7rem 0 1rem; }
  .newsletter-section p { line-height:1.6; max-width:38rem; }
  .newsletter-archive-link { font-weight:600; text-decoration:underline; text-underline-offset:4px; }
  .newsletter-form { align-self:center; }
  .newsletter-form > label { display:block; font-weight:600; margin-bottom:.6rem; }
  .signup-row { display:flex; gap:.6rem; }
  .signup-row input { min-width:0; width:100%; border:1px solid #7d9689; border-radius:8px; padding:.9rem; font:inherit; background:white; color:#20351f; }
  .signup-row button { white-space:nowrap; border:0; cursor:pointer; }
  .signup-row button:disabled { opacity:.65; cursor:wait; }
  .newsletter-form .newsletter-consent { display:flex; align-items:flex-start; gap:.6rem; margin-top:1rem; font-size:.85rem; font-weight:400; line-height:1.5; }
  .newsletter-consent input { margin-top:4px; flex-shrink:0; accent-color:#20351f; }
  .newsletter-note { font-size:.8rem; color:#516358; }
  .newsletter-status { font-size:.9rem; font-weight:600; }
  .newsletter-status:empty { display:none; }
  .newsletter-trap { position:absolute; left:-10000px; width:1px; height:1px; overflow:hidden; }
  @media(max-width:760px) { .newsletter-section { grid-template-columns:1fr; gap:1.5rem; } }
  @media(max-width:420px) { .signup-row { flex-direction:column; } }
</style>
