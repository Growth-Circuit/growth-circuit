---
import NewsletterFields from "@/components/NewsletterFields.astro";
import { jobsCopy } from "@/lib/newsletter-copy";
interface Props {
  variant?: "events" | "jobs";
  id?: string;
}
const { id = "sidebar-newsletter", variant = "events" } = Astro.props;
---

<aside class="sidebar-email-cta" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="sidebar-email-title">{variant === "jobs" ? jobsCopy.headline : "Find the best NYC events for marketers"}</h2>
  <p class="sidebar-email-desc">
    {variant === "jobs" ? jobsCopy.body : "Public talks, demos, meetups, and Growth Circuit gatherings. A short list from Nick and Lucy for people building things in marketing, growth, and AI."}
  </p>
  <NewsletterFields
    id={id}
    formLabel={variant === "jobs" ? "Subscribe to the jobs newsletter" : "Subscribe to the NYC newsletter"}
    tone="light"
  />
</aside>

<style>
  .sidebar-email-cta {
    position: sticky;
    top: 100px;
    border: 1px solid var(--pivot-line);
    border-radius: 20px;
    background: var(--sky-blue);
    padding: 22px;
  }

  .sidebar-email-title {
    margin: 0 0 8px;
    color: var(--pivot-navy);
    font-size: 18px;
    font-weight: 760;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .sidebar-email-desc {
    margin: 0 0 16px;
    color: var(--sky-muted);
    font-size: 14px;
    line-height: 1.5;
  }
</style>
