---
type Props = {
  eyebrow: string;
  title: string;
  description: string;
};

const { eyebrow, title, description } = Astro.props;
---

<section class="shell page-title announcement-hold">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{description}</p>
  <div class="hero-actions hold-actions">
    <a class="button matcha" href="/nyc#apply">Apply for the build club</a>
    <a class="button" href="/#global">Global community next</a>
  </div>
</section>
