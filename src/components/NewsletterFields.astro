---
interface Props {
  id: string;
  formLabel: string;
  tone?: "light" | "dark";
  formClass?: string;
  layout?: "stacked" | "paired";
}
const { id, formLabel, tone = "light", formClass, layout = "stacked" } = Astro.props;
---

<div class="gc-signup-wrap">
  <form method="post" action="/api/newsletter" class:list={["gc-signup", "newsletter-form", formClass, { "gc-signup-paired": layout === "paired" }]} data-tone={tone} data-layout={layout} aria-label={formLabel}>
    <div class="gc-signup-fields">
      <label class="gc-signup-label" for={`${id}-email`}>Email address</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="254" placeholder="nick@growthcircuit.club" required />
      <label class="gc-signup-label" for={`${id}-linkedin`}>LinkedIn profile</label>
      <input id={`${id}-linkedin`} name="linkedin" type="url" maxlength="200" autocomplete="off" placeholder="linkedin.com/in/nicklafferty" aria-describedby={`${id}-linkedin-hint`} required />
    </div>
    <button class="gc-signup-button" type="submit">Subscribe to Growth Circuit</button>
    <p class="gc-signup-hint" id={`${id}-linkedin-hint`}>We use your LinkedIn to tailor what we send you.</p>
    <label class="gc-signup-consent newsletter-consent"><input name="consent" type="checkbox" checked required /> <span>I want to receive emails from Growth Circuit</span></label>
    <div class="gc-signup-trap" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <p class="gc-signup-status newsletter-status" role="status" aria-live="polite"></p>
    <noscript>Please enable JavaScript to use this signup form.</noscript>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>(".gc-signup").forEach((form) => {
    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const status = form.querySelector<HTMLElement>(".gc-signup-status")!;
      const fields = new FormData(form);
      button.disabled = true;
      status.textContent = "Sending your confirmation email…";
      try {
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: fields.get("email"),
            linkedin: fields.get("linkedin"),
            consent: fields.get("consent") === "on",
            website: fields.get("website"),
          }),
        });
        const result = await response.json().catch(() => ({ error: "This is temporarily unavailable. Please try again shortly." })) as { error?: string };
        if (!response.ok) throw new Error(result.error || "Signup is temporarily unavailable. Please try again shortly.");
        status.textContent = "Check your inbox to confirm. If you already requested a link, use that email. The link is valid for 24 hours.";
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Please try again shortly.";
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .gc-signup-wrap { container-type: inline-size; width: 100%; }
  .gc-signup { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 8px; row-gap: 10px; align-items: start; position: relative; }
  .gc-signup-fields { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .gc-signup-label { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
  .gc-signup input[type="email"],
  .gc-signup input[type="url"] { width: 100%; min-height: 52px; box-sizing: border-box; border: 2px solid #17313a; border-radius: 999px; padding: 12px 18px; background: #fff; color: #17313a; font: inherit; font-size: 17px; }
  .gc-signup input::placeholder { color: #55717b; font-size: 10px; }
  .gc-signup input:focus-visible { outline: 3px solid #f6a93b; outline-offset: 2px; }
  .gc-signup-button { grid-column: 2; grid-row: 1; align-self: start; min-height: 52px; max-width: 100%; border: 0; border-radius: 999px; padding: 12px 22px; background: #17313a; color: #fff; font: inherit; font-size: 16px; font-weight: 600; line-height: 1.2; text-align: center; white-space: nowrap; cursor: pointer; }
  .gc-signup[data-tone="dark"] .gc-signup-button { background: #f6a93b; color: #17313a; }
  .gc-signup-button:disabled { opacity: .65; cursor: wait; }
  .gc-signup-hint { grid-column: 1 / -1; justify-self: start; width: fit-content; max-width: 100%; margin: 0; font-size: 13px; font-weight: 400; line-height: 1.45; color: #17313a; }
  .gc-signup-consent { grid-column: 1 / -1; display: flex; align-items: flex-start; gap: 8px; margin: 0; font-size: 13px; font-weight: 400; line-height: 1.45; color: #17313a; }
  .gc-signup-consent input { margin-top: 3px; flex-shrink: 0; accent-color: #17313a; }
  .gc-signup[data-tone="dark"] .gc-signup-hint,
  .gc-signup[data-tone="dark"] .gc-signup-consent { color: #fff; }
  .gc-signup[data-tone="dark"] .gc-signup-consent input { accent-color: #fff; }
  .gc-signup-status { grid-column: 1 / -1; margin: 0; font-size: 15px; font-weight: 600; line-height: 1.4; }
  .gc-signup-status:empty { display: none; }
  .gc-signup-trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .gc-signup-paired { grid-template-columns: minmax(0, 1fr); }
  .gc-signup-paired .gc-signup-fields { grid-column: 1; grid-row: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; width: 100%; }
  .gc-signup-paired .gc-signup-button { grid-column: 1; grid-row: 2; width: 100%; }
  .gc-signup-paired .gc-signup-hint { grid-row: 3; }
  .gc-signup-paired .gc-signup-consent { grid-row: 4; }
  .gc-signup-paired .gc-signup-status { grid-row: 5; }
  @media (max-width: 390px) {
    .gc-signup-paired .gc-signup-fields { grid-template-columns: minmax(0, 1fr); }
  }
  @container (max-width: 440px) {
    .gc-signup { grid-template-columns: minmax(0, 1fr); }
    .gc-signup-button { grid-column: 1; grid-row: 2; width: 100%; padding: 12px 16px; font-size: 15px; }
    .gc-signup-hint { grid-row: 3; }
    .gc-signup-consent { grid-row: 4; }
    .gc-signup-status { grid-row: 5; }
  }
</style>
