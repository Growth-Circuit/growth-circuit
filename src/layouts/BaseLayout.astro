---
import "@/styles/global.css";
import "@/styles/site-theme.css";
import SiteHead, { type Props as SiteHeadProps } from "@/components/SiteHead.astro";
import SiteHeader from "@/components/SiteHeader.astro";

type Props = SiteHeadProps & {
  hideHeader?: boolean;
  bodyClass?: string;
};

const { hideHeader = false, bodyClass, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {...head} />
  </head>
  <body class={bodyClass} id="gc-site">
    {!hideHeader && <SiteHeader />}
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="shell">
        <div class="footer-title">See you around<br />the neighborhood.</div>
        <nav class="footer-links" aria-label="Explore Growth Circuit">
          <a href="/newsletter">Newsletter</a>
          <a href="/events">Events</a>
          <a href="/blog">Blog</a>
          <a href="/people">Member projects</a>
          <a href="/ship-or-skip">Ship or Skip</a>
        </nav>
        Growth Circuit is run by
        <a
          href="https://www.linkedin.com/in/nicklafferty/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Nick Lafferty
        </a>
        at Profound and
        <a
          href="https://www.linkedin.com/in/lucyjanehoyle"
          target="_blank"
          rel="noopener noreferrer"
        >
          Lucy Hoyle
        </a>
        at Carta.
      </div>
    </footer>
  </body>
</html>
