---
import "@/styles/global.css";
import { canonical, organizationJsonLd, serializeJsonLd } from "@/lib/seo";

type Props = {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
  hideHeader?: boolean;
  bodyClass?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialType?: "website" | "article";
};

const {
  title = "Growth Circuit",
  description = "A close-knit community for Marketing Engineers based in New York City.",
  path = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
  hideHeader = false,
  bodyClass,
  socialImage,
  socialImageAlt: suppliedSocialImageAlt,
  socialType = "website",
} = Astro.props;

const fullTitle = title === "Growth Circuit" ? title : `${title} | Growth Circuit`;
const canonicalUrl = canonical(path);
const socialImageUrl = socialImage ? canonical(socialImage) : canonical("/growth-circuit-og-v2.png");
const socialImageAlt = suppliedSocialImageAlt || "Growth Circuit: Make cool sh*t together. New York, September 2026.";
const allJsonLd = [organizationJsonLd(), ...jsonLd];
const themeColor = bodyClass?.includes("sky-page") ? "#dceef5" : "#101418";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/growth-circuit-icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/growth-circuit-favicon-256.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Growth Circuit" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {allJsonLd.map((entry) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(entry)} />)}
  </head>
  <body class={bodyClass}>
    {
      !hideHeader && (
        <header class="site-header">
          <div class="shell nav">
            <a class="brand" href="/" aria-label="Growth Circuit home">
              <img class="brand-logo" src="/growth-circuit-icon.svg" alt="" width="44" height="44" />
              <span>Growth Circuit</span>
            </a>
            {path !== "/apply" && (
              <div class="header-actions">
                <a class="button button--community" href="/community">Community</a>
                <a class="button matcha" href="/apply">Apply</a>
              </div>
            )}
          </div>
        </header>
      )
    }
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="shell">
        Growth Circuit is an independent community founded by
        <a
          href="https://www.linkedin.com/in/lucyjanehoyle"
          target="_blank"
          rel="noopener noreferrer"
        >
          Lucy Hoyle
        </a>
        and
        <a
          href="https://www.linkedin.com/in/nicklafferty/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Nick Lafferty
        </a>.
      </div>
    </footer>
  </body>
</html>
