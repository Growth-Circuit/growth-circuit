---
import "@/styles/global.css";
import AuthBar from "@/components/AuthBar";
import { canonical, organizationJsonLd } from "@/lib/seo";

type Props = {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
};

const {
  title = "Growth Circuit",
  description = "A public forum and NYC supper club for marketing engineers. Bring Your Own Build.",
  path = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = title === "Growth Circuit" ? title : `${title} | Growth Circuit`;
const canonicalUrl = canonical(path);
const allJsonLd = [organizationJsonLd(), ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Growth Circuit" />
    <meta name="twitter:card" content="summary_large_image" />
    {allJsonLd.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href="/" aria-label="Growth Circuit home">
          <span class="brand-mark">GC</span>
          <span>Growth Circuit</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/questions">Questions</a>
          <a href="/builds">Builds</a>
          <a href="/challenges">Challenges</a>
          <a href="/nyc">NYC Supper Club</a>
        </nav>
        <div class="header-actions">
          <AuthBar client:load />
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="shell">
        Growth Circuit is an independent community founded by Lucy Hoyle and Nick Lafferty.
      </div>
    </footer>
  </body>
</html>
