{
  "name": "growth-circuit",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "images": {
    "binding": "IMAGES"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["auth@growthcircuit.club"]
    }
  ],
  // Encrypted server binding required at deploy time: SUPABASE_SERVICE_ROLE_KEY
  "routes": [
    { "pattern": "growthcircuit.club", "custom_domain": true },
    { "pattern": "www.growthcircuit.club", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://growthcircuit.club",
    // The member portal is parked while Growth Circuit shifts to public events, WhatsApp, and public profiles.
    "COMMUNITY_FEATURE_ENABLED": "false",
    "COMMUNITY_KILL_SWITCH": "true",
    "BUZZ_WEBHOOK_URL": "https://growth-circuit-buzz-relay.vercel.app/api/notify",
    "CRM_SYNC_ENABLED": "true",
    "LOOPS_COHORT_OPENINGS_LIST_ID": "cmsxf6xb520ym0izgfvm41c01",
    "LOOPS_COMMUNITY_UPDATES_LIST_ID": "cmsxf7r8g00hv0j0732pqc8lk",
    "LOOPS_EVENTS_LIST_ID": "cmsxf83ve226k0jzk6f3ha4j0",
    "NOTION_APPLICATIONS_DATA_SOURCE_ID": "3b0b74c7ad91803fa41c000b268d883c",
    "NOTION_PEOPLE_DATA_SOURCE_ID": "51924dca353a4281a4624e48d02157fe",
    "PUBLIC_SUPABASE_URL": "https://twkvclxsynnbktppeozg.supabase.co",
    "PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HtrWzzR4HB4Xu0rlSnLaXQ_mpKm0zun"
  },
  "kv_namespaces": [
    {
      "binding": "BUZZ_DELIVERY_LEDGER",
      "id": "943b37dfb7f74a71833818ff95844aab"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CRM_PERSON_LOCK",
        "class_name": "CrmPersonLock"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CrmPersonLock"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BUZZ_SUBMISSION_ALERTS",
        "queue": "growth-circuit-submission-alerts"
      },
      {
        "binding": "CRM_SYNC_QUEUE",
        "queue": "growth-circuit-crm-sync"
      }
    ],
    "consumers": [
      {
        "queue": "growth-circuit-submission-alerts",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "max_concurrency": 1,
        "dead_letter_queue": "growth-circuit-submission-alerts-dlq"
      },
      {
        "queue": "growth-circuit-submission-alerts-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1
      },
      {
        "queue": "growth-circuit-crm-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "max_concurrency": 2,
        "dead_letter_queue": "growth-circuit-crm-sync-dlq"
      },
      {
        "queue": "growth-circuit-crm-sync-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
