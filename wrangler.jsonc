{
  "name": "growth-circuit",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "growthcircuit.club", "custom_domain": true },
    { "pattern": "www.growthcircuit.club", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
