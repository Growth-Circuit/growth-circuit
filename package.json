{
  "name": "growth-circuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "validate:members": "node --experimental-strip-types scripts/validate-members.mjs",
    "build": "npm run validate:members && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "test": "ASTRO_TELEMETRY_DISABLED=1 vitest run",
    "test:watch": "ASTRO_TELEMETRY_DISABLED=1 vitest",
    "test:db": "supabase test db",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.7.0",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/react": "5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "3.7.3",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "astro": "6.4.8",
    "ical.js": "^2.2.1",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "standardwebhooks": "1.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.62.1",
    "supabase": "2.114.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
